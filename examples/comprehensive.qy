;; 综合示例：所有 Qy 特性一览
;; 逐项演示算术、引用、比较、列表、条件、函数、let、递归

; --- 算术运算 ---
(+ 1 2 3 4 5)                       ; => 15
(- 100 25 25)                       ; => 50
(* 2 3 5 7)                         ; => 210
(/ 1000 2 5 10)                     ; => 10

; --- 嵌套算术 ---
(+ (* 3 4) (- 10 5) (/ 20 4))      ; => 12 + 5 + 5 = 22

; --- 引用与符号 ---
'hello                              ; => Symbol("hello")
'(a b c)                            ; => 符号列表
(quote (nested quoted list))        ; => 嵌套引用

; --- 相等比较 ---
(eq 'a 'a)                          ; => true
(eq 'a 'b)                          ; => false
(eq '() '())                        ; => true

; --- Atom 判断 ---
(atom 'x)                           ; => true
(atom '(x y))                       ; => false
(atom '())                          ; => true

; --- 列表操作 ---
(car '(first second third))         ; => Symbol("first")
(cdr '(first second third))         ; => (Symbol("second"), Symbol("third"))
(cons 'new '(old items))            ; => '(new old items)
(cons 'a (cons 'b (cons 'c '())))   ; => '(a b c)

; --- 链式列表操作 ---
(car (cdr '(a b c)))                ; => Symbol("b")
(cdr (cdr '(a b c d)))              ; => '(c d)

; --- 条件表达式 ---
(cond (true 'yes) (false 'no))      ; => 'yes
(cond (false 'first) (true 'second)); => 'second
(cond (false 1) (false 2) (true 3)) ; => 3

; --- 函数定义 ---
(defun square (x) (* x x))
(square 7)                          ; => 49

(defun hypotenuse (a b)
  (+ (square a) (square b)))

(hypotenuse 3 4)                    ; => 25（勾股定理）

; --- let 局部绑定 ---
(let
  ((x 10)
   (y 20))
  (+ x y))                          ; => 30

(let
  ((name "Qy"))
  name)                             ; => Symbol("Qy")

; --- let + defun（闭包） ---
(let
  ((multiplier 3))
  (defun scale (x) (* x multiplier))
  (scale 10))                       ; => 30

; --- 递归 ---
(defun fact (n)
  (cond
    ((eq n 0) 1)
    (true (* n (fact (- n 1))))))

(fact 6)                            ; => 720

(defun fib (n)
  (cond
    ((eq n 0) 0)
    ((eq n 1) 1)
    (true (+ (fib (- n 1)) (fib (- n 2))))))

(fib 8)                             ; => 21

; --- 列表递归 ---
(defun length (lst)
  (cond
    ((atom lst) 0)
    (true (+ 1 (length (cdr lst))))))

(length '(a b c d e))               ; => 5

(defun append (a b)
  (cond
    ((atom a) b)
    (true (cons (car a) (append (cdr a) b)))))

(append '(1 2 3) '(4 5 6))         ; => '(1 2 3 4 5 6)

(defun reverse (lst)
  (defun helper (lst acc)
    (cond
      ((atom lst) acc)
      (true (helper (cdr lst) (cons (car lst) acc)))))
  (helper lst '()))

(reverse '(a b c d))                ; => '(d c b a)

; --- 复合表达式 ---
(defun sum-list (lst)
  (cond
    ((atom lst) 0)
    (true (+ (car lst) (sum-list (cdr lst))))))

(let
  ((nums '(10 20 30)))
  (/ (sum-list nums) 3))            ; => 20.0（平均值）

; --- 覆盖字面量 ---
(let
  ((1 42))
  (+ 1 1))                          ; => 84（局部作用域中 1 = 42）
