; 兼容示例：cons 仍然是构造 chain cell 的算子

(print '())                 ; => ()
(print '(a b c))            ; => (a b c)
(print '(a . b))            ; => (a . b)

(print (cons 'a '()))       ; => (a)
(print (cons 'a '(b c)))    ; => (a b c)
(print (cons 'a 'b))        ; => (a . b)

(print (type '(a b c)))     ; => chain
(print (== '(a b) '(a b)))  ; => true
(eq '(a b) '(a b))          ; => false
