; Qy cons list 与 Python list 是不同的数据结构

(print '())                 ; => ()
(print '(a b c))            ; => (a b c)
(print '(a . b))            ; => (a . b)

(print (cons 'a '()))       ; => (a)
(print (cons 'a '(b c)))    ; => (a b c)
(print (cons 'a 'b))        ; => (a . b)

(print (car '(a b c)))      ; => a
(print (cdr '(a b c)))      ; => (b c)
(print (cdr '(a . b)))      ; => b

(print (list 'a 'b 'c))     ; => [a b c]
(print (py
  """
return [type(qy_list).__name__, list(qy_list), isinstance(py_list, list)]
"""
  :qy-list '(1 2)
  :py-list (list 1 2)))     ; => [QyCons [1 2] true]

(print (list? '(a b c)))    ; => false
(list? (list 'a))           ; => true
