;; 经典算法
;; 排序、阿克曼函数、Collatz 猜想、2的幂检测、异或

; 插入排序
(defun insert (x sorted)
  (cond
    ((atom sorted) (cons x '()))     ; 空列表：x 即为结果
    ((eq (car sorted) x) (cons x sorted)) ; 简化处理
    (true (cons (car sorted) (insert x (cdr sorted))))))

(defun isort (lst)
  (cond
    ((atom lst) '())
    (true (insert (car lst) (isort (cdr lst))))))

(isort '())                          ; => ()
(isort '(5))                         ; => (5)
(isort '(3 1 4 1 5 9 2 6))          ; => 插入排序结果

; 合并两个有序列表（简化版）
(defun merge (a b)
  (cond
    ((atom a) b)
    ((atom b) a)
    (true (cons (car a) (merge (cdr a) b)))))

(merge '(1 3 5) '(2 4 6))           ; => 合并结果

; 数字符号转整数
(defun digit-to-int (d)
  (cond
    ((eq d '0) 0) ((eq d '1) 1) ((eq d '2) 2)
    ((eq d '3) 3) ((eq d '4) 4) ((eq d '5) 5)
    ((eq d '6) 6) ((eq d '7) 7) ((eq d '8) 8)
    ((eq d '9) 9) (true 0)))

(digit-to-int '5)                    ; => 5
(digit-to-int '0)                    ; => 0

; 阿克曼函数（仅限小参数，增长极快）
(defun ack (m n)
  (cond
    ((eq m 0) (+ n 1))
    ((eq n 0) (ack (- m 1) 1))
    (true (ack (- m 1) (ack m (- n 1))))))

(ack 0 0)                           ; => 1
(ack 1 1)                           ; => 3
(ack 2 2)                           ; => 7
(ack 3 3)                           ; => 61

; 2 的幂检测
(defun pow2-helper (n acc)
  (cond
    ((eq acc n) true)                ; acc 恰好等于 n
    ((eq acc 0) false)               ; 溢出保护
    (true (pow2-helper n (* acc 2)))))

(defun is-power-of-2 (n)
  (cond
    ((eq n 1) true)
    ((eq n 0) false)
    (true (pow2-helper n 2))))

(is-power-of-2 1)                   ; => true（2^0）
(is-power-of-2 8)                   ; => true（2^3）
(is-power-of-2 7)                   ; => false
(is-power-of-2 16)                  ; => true（2^4）

; Collatz 猜想：序列长度
(defun collatz (n)
  (cond
    ((eq n 1) 0)
    (true (+ 1 (collatz-helper n)))))

(defun collatz-helper (n)
  (cond
    ((eq n 1) 0)
    (true (let
      ((next (cond ((eq (/ n 2) 0) (/ n 2)) (true (+ (* 3 n) 1)))))
      (+ 1 (collatz-helper next))))))

; 异或（XOR）：用 cond 实现布尔逻辑
(defun xor (a b)
  (cond
    (a (cond (b false) (true true)))    ; a=true: 结果=!b
    (true (cond (b true) (true false))))) ; a=false: 结果=b

(xor true false)                     ; => true
(xor false true)                     ; => true
(xor true true)                      ; => false
(xor false false)                    ; => false
