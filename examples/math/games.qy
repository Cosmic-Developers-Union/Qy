;; 数学游戏与趣味题
;; FizzBuzz、汉诺塔、闰年、杨辉三角、数字翻转

; FizzBuzz：经典编程面试题
(defun divisible (n d)
  (eq (* d (/ n d)) n))             ; 通过乘法验证整除

(defun fizzbuzz-step (n)
  (cond
    ((divisible n 15) "FizzBuzz")   ; 同时被 3 和 5 整除
    ((divisible n 3) "Fizz")        ; 被 3 整除
    ((divisible n 5) "Buzz")        ; 被 5 整除
    (true n)))                       ; 其他数字原样返回

(fizzbuzz-step 1)                   ; => 1
(fizzbuzz-step 3)                   ; => "Fizz"
(fizzbuzz-step 5)                   ; => "Buzz"
(fizzbuzz-step 15)                  ; => "FizzBuzz"
(fizzbuzz-step 7)                   ; => 7
(fizzbuzz-step 30)                  ; => "FizzBuzz"

; 汉诺塔移动次数：2^n - 1
(defun hanoi-moves (n)
  (cond
    ((eq n 0) 0)
    (true (+ 1 (* 2 (hanoi-moves (- n 1)))))))

(hanoi-moves 1)                     ; => 1
(hanoi-moves 2)                     ; => 3
(hanoi-moves 3)                     ; => 7
(hanoi-moves 4)                     ; => 15
(hanoi-moves 5)                     ; => 31

; 闰年判断：能被400整除 或 能被4整除但不能被100整除
(defun leap-year (y)
  (let
    ((div4 (eq (* 4 (/ y 4)) y))
     (div100 (eq (* 100 (/ y 100)) y))
     (div400 (eq (* 400 (/ y 400)) y)))
    (cond
      (div400 true)                  ; 能被400整除 => 闰年
      (div100 false)                 ; 能被100但不能被400 => 非闰年
      (div4 true)                    ; 能被4但不能被100 => 闰年
      (true false))))                ; 其他 => 非闰年

(leap-year 2000)                     ; => true
(leap-year 1900)                     ; => false
(leap-year 2024)                     ; => true
(leap-year 2023)                     ; => false

; 杨辉三角第 n 行（利用组合数 C(n,k)）
(defun fact (n)
  (cond
    ((eq n 0) 1)
    (true (* n (fact (- n 1))))))

(defun choose (n k)
  (/ (fact n) (* (fact k) (fact (- n k)))))

(defun pascal-row (n)
  (defun pascal-helper (i)
    (cond
      ((eq i (+ n 1)) '())
      (true (cons (choose n i) (pascal-helper (+ i 1))))))
  (pascal-helper 0))

(pascal-row 0)                       ; => (1)
(pascal-row 1)                       ; => (1 1)
(pascal-row 4)                       ; => (1 4 6 4 1)
(pascal-row 5)                       ; => (1 5 10 10 5 1)

; 数字各位之和
(defun digit-sum (n)
  (cond
    ((eq n 0) 0)
    (true (+ (- n (* 10 (/ n 10))) (digit-sum (/ n 10))))))

(digit-sum 123)                      ; => 6（1+2+3）
(digit-sum 999)                      ; => 27（9+9+9）
(digit-sum 1000)                     ; => 1

; 完全平方数检测
(defun is-square-helper (n i)
  (cond
    ((eq (* i i) n) true)
    ((* i i) false)                  ; i*i > n（利用整数截断）
    (true (is-square-helper n (+ i 1)))))

; 翻转数字
(defun reverse-num (n)
  (defun rev-helper (n acc)
    (cond
      ((eq n 0) acc)
      (true (rev-helper (/ n 10) (+ (* acc 10) (- n (* 10 (/ n 10))))))))
  (rev-helper n 0))

(reverse-num 12345)                  ; => 54321
(reverse-num 1000)                   ; => 1（前导零被丢弃）
