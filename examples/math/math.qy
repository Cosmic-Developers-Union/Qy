;; 数学计算
;; 幂运算、三角数、组合数、多项式、单位转换、连乘

; 前 N 个自然数之和：n*(n+1)/2
(defun sum-n (n) (/ (* n (+ n 1)) 2))
(sum-n 10)                          ; => 55
(sum-n 100)                         ; => 5050

; 幂运算（递归实现）
(defun power (base exp)
  (cond
    ((eq exp 0) 1)                  ; base^0 = 1
    (true (* base (power base (- exp 1))))))

(power 2 0)                         ; => 1
(power 2 1)                         ; => 2
(power 2 10)                        ; => 1024
(power 3 4)                         ; => 81

; 三角数：0+1+2+...+n
(defun triangular (n)
  (cond
    ((eq n 0) 0)
    (true (+ n (triangular (- n 1))))))

(triangular 0)                      ; => 0
(triangular 5)                      ; => 15
(triangular 10)                     ; => 55

; 数字各位之和（递归拆位）
(defun sum-digits (n)
  (cond
    ((eq n 0) 0)
    (true (+ (- n (* (/ n 10) 10)) (sum-digits (/ n 10))))))

; 最大公约数（欧几里得算法）
(defun gcd (a b)
  (cond
    ((eq b 0) a)
    (true (gcd b (- a (* b (/ a b)))))))

; 勾股定理：a² + b²
(defun pythagorean-sum (a b)
  (+ (* a a) (* b b)))

(pythagorean-sum 3 4)               ; => 25（直角三角形斜边平方）

; 组合数 C(n,k) = n! / (k! * (n-k)!)
(defun fact (n)
  (cond
    ((eq n 0) 1)
    (true (* n (fact (- n 1))))))

(defun choose (n k)
  (/ (fact n) (* (fact k) (fact (- n k)))))

(choose 5 2)                        ; => 10
(choose 10 3)                       ; => 120
(choose 10 0)                       ; => 1

; 多项式求值：3x² + 2x + 1
(defun poly-3-2-1 (x)
  (+ (* 3 (* x x)) (* 2 x) 1))

(poly-3-2-1 0)                      ; => 1
(poly-3-2-1 1)                      ; => 6
(poly-3-2-1 5)                      ; => 86

; 华氏转摄氏：(F - 32) * 5 / 9
(defun f-to-c (f)
  (/ (* (- f 32) 5) 9))

(f-to-c 32)                         ; => 0（冰点）
(f-to-c 212)                        ; => 100（沸点）
(f-to-c 98)                         ; => 36.67（体温）

; 列表连乘
(defun product (lst)
  (cond
    ((atom lst) 1)
    (true (* (car lst) (product (cdr lst))))))

(product '(1 2 3 4 5))              ; => 120
(product '(2 4 6 8))                ; => 384
