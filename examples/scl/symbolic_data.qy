;; 符号数据建模
;; 所有原子都是符号，语义来自解析（resolution）
;; 这些示例展示 Qy 作为声明式数据描述语言的能力

; 元数据
(metadata
  (title "Introduction to Symbolic Computing")
  (author "Qy Project")
  (version "0.0.4")
  (tags "lisp" "symbolic" "language" "python"))

; 嵌套文档结构
(document
  (header (title "Qy Language Guide") (level 1))
  (section
    (header (title "Getting Started") (level 2))
    (paragraph "Qy is a symbolic component lisp"))
  (section
    (header (title "Core Concepts") (level 2))
    (paragraph "Everything is a symbol")))

; 树形结构
(tree
  (node "root"
    (node "child-a"
      (node "leaf-1")
      (node "leaf-2"))
    (node "child-b"
      (node "leaf-3"))))

; 键值对配置（keyword 风格）
(config
  (database
    (host "localhost")
    (port "5432")
    (name "qy_dev"))
  (server
    (host "0.0.0.0")
    (port "8080"))
  (logging
    (level "info")
    (format "json")))

; 管道描述（未来：planner operator）
(pipeline
  (source (load "documents"))
  (transform (chunk :size 512 :overlap 64))
  (enrich (embed :model "text-embedding-3-small"))
  (sink (index :namespace "default")))

; 能力配置（capability gating）
(capabilities
  (let true)
  (component true)
  (recursion true)
  (macro false)
  (filesystem "read_only")
  (network "deny"))

; 图节点描述（未来：DAG 执行图）
(dag
  (node (id "load-a") (op "load") (args "source-a"))
  (node (id "load-b") (op "load") (args "source-b"))
  (node (id "merge") (op "concat") (inputs "load-a" "load-b"))
  (node (id "embed") (op "embed") (inputs "merge")))

; 组件定义（未来：graph template）
(component index-source (source namespace)
  (pipeline
    (load source)
    (chunk :size 800)
    (embed)
    (index :namespace namespace)))

; Schema 定义
(schema "user"
  (field (name "id") (type "int") (primary true))
  (field (name "name") (type "string"))
  (field (name "email") (type "string") (unique true))
  (field (name "active") (type "bool") (default true)))

; API 路由定义
(routes
  (route (method "GET") (path "/api/users") (handler "list_users"))
  (route (method "GET") (path "/api/users/:id") (handler "get_user"))
  (route (method "POST") (path "/api/users") (handler "create_user"))
  (route (method "DELETE") (path "/api/users/:id") (handler "delete_user")))
