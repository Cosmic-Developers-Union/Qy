;; 管道与数据流（SCL 风格）
;; 展示符号级图构建，描述数据处理管道的各个阶段

; 文档处理管道
(pipeline
  (stage (name "ingest") (op "load") (source "file://data/*.txt"))
  (stage (name "chunk") (op "split") (size 512) (overlap 64))
  (stage (name "embed") (op "embedding") (model "text-embedding-3-small"))
  (stage (name "store") (op "index") (backend "vectorstore")))

; 并行执行图：同一数据源分发给多个处理分支
(parallel
  (branch (embed (load "docs")))
  (branch (extract-meta (load "docs")))
  (branch (classify (load "docs"))))

; 带依赖关系的 DAG（有向无环图）
(dag
  (inputs
    (node (id "raw-a") (op "load") (path "data/source-a.jsonl"))
    (node (id "raw-b") (op "load") (path "data/source-b.jsonl")))
  (transforms
    (node (id "merged") (op "concat") (deps "raw-a" "raw-b"))
    (node (id "cleaned") (op "filter") (deps "merged") (predicate "non-empty"))
    (node (id "chunked") (op "chunk") (deps "cleaned") (size 800)))
  (outputs
    (node (id "embedded") (op "embed") (deps "chunked"))
    (node (id "indexed") (op "index") (deps "embedded"))))

; ETL 管道（抽取-转换-加载）
(etl
  (extract
    (source (type "csv") (path "users.csv"))
    (source (type "api") (url "https://api.example.com/events")))
  (transform
    (step (name "validate") (rules
      (field "email" (type "string") (required true))
      (field "timestamp" (type "int") (required true))))
    (step (name "normalize") (mapping
      (field "email" (transform "lowercase"))
      (field "timestamp" (transform "iso8601")))))
  (load
    (target (type "database") (table "events"))
    (mode "upsert")
    (batch-size 1000)))

; RAG（检索增强生成）管道
(rag
  (indexing
    (load (source "documents/") (format "markdown"))
    (chunk (strategy "semantic") (max-size 1000))
    (embed (model "text-embedding-3-large"))
    (store (backend "pinecone") (namespace "prod")))
  (retrieval
    (query (embed (model "text-embedding-3-large")))
    (search (top-k 5) (strategy "hybrid"))
    (rerank (model "rerank-v1")))
  (generation
    (template r"""
      Context: {context}
      Question: {question}
      Answer:
    """)
    (model (name "gpt-4") (temperature 0.3))))

; 带分支的工作流
(workflow
  (trigger (type "webhook") (path "/ingest"))
  (steps
    (step (id "validate") (op "schema-check") (input "payload"))
    (step (id "route")
      (cond
        ((eq "type" "document") (go "process-doc"))
        ((eq "type" "url") (go "fetch-url"))
        (true (go "reject"))))
    (step (id "process-doc") (op "parse") (format "auto"))
    (step (id "fetch-url") (op "http-get") (url "url"))
    (step (id "reject") (op "log") (level "warn"))))
