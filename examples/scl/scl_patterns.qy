;; SCL 模式：用当前 Qy 特性模拟 SCL 概念
;; 展示如何用 defun + let + 递归来实现图节点、管道、能力检查等模式

; --- 符号图节点表示 ---

; 用 cons 构造三元组：(id op inputs)
(defun make-node (id op inputs)
  (cons id (cons op (cons inputs '()))))

(defun node-id (n) (car n))
(defun node-op (n) (car (cdr n)))
(defun node-inputs (n) (car (cdr (cdr n))))

(let
  ((node-a (make-node 'load-a 'load '()))
   (node-b (make-node 'load-b 'load '()))
   (node-c (make-node 'merge 'concat '(load-a load-b)))
   (node-d (make-node 'embed 'embed '(merge))))
  (cons (node-id node-d) (node-op node-d)))  ; => (embed . embed)

; --- 符号管道构建 ---

; 构造管道阶段：(name op config)
(defun pipeline-stage (name op config)
  (cons name (cons op (cons config '()))))

(defun stage-name (s) (car s))
(defun stage-op (s) (car (cdr s)))
(defun stage-config (s) (car (cdr (cdr s))))

(let
  ((s1 (pipeline-stage 'ingest 'load "source-a"))
   (s2 (pipeline-stage 'chunk 'split "size=512"))
   (s3 (pipeline-stage 'embed 'embedding "model=v3"))
   (s4 (pipeline-stage 'store 'index "backend=vs")))
  (cons s1 (cons s2 (cons s3 (cons s4 '())))))  ; 管道列表

; --- 能力检查 ---
(defun has-capability (cap capabilities)
  (cond
    ((atom capabilities) false)
    ((eq cap (car (car capabilities))) true)
    (true (has-capability cap (cdr capabilities)))))

(let
  ((caps '((let true) (component true) (recursion false) (macro false))))
  (has-capability 'let caps))       ; => true

(let
  ((caps '((let true) (component true) (recursion false) (macro false))))
  (has-capability 'macro caps))     ; => true

(let
  ((caps '((let true) (component true) (recursion false) (macro false))))
  (has-capability 'network caps))   ; => false（未定义）

; --- 符号 Schema 校验 ---
(defun field-present (name fields)
  (cond
    ((atom fields) false)
    ((eq name (car (car fields))) true)
    (true (field-present name (cdr fields)))))

; 统计 schema 中存在的字段数量
(let
  ((schema '((id true) (name true) (email true) (active false))))
  (+ (cond ((field-present 'id schema) 1) (true 0))
     (cond ((field-present 'name schema) 1) (true 0))
     (cond ((field-present 'email schema) 1) (true 0))
     (cond ((field-present 'age schema) 1) (true 0))))  ; => 3

; --- 路由匹配（符号级） ---
(defun match-method (method route)
  (eq method (car route)))

(defun match-path (path route)
  (eq path (car (cdr route))))

(let
  ((routes '((GET "/api/users") (GET "/api/users/:id") (POST "/api/users"))))
  (match-method 'GET (car routes)))  ; => true

; --- 配置查找 ---
(defun config-get (key config)
  (cond
    ((atom config) nil)
    ((eq key (car (car config))) (car (cdr (car config))))
    (true (config-get key (cdr config)))))

(let
  ((config '((host "localhost") (port 5432) (name "qy_dev"))))
  (config-get 'port config))         ; => 5432

(let
  ((config '((host "localhost") (port 5432) (name "qy_dev"))))
  (config-get 'name config))         ; => "qy_dev"

; --- 符号数据转换 ---
(defun transform-pair (pair)
  (cons (car pair) (cons (car (cdr pair)) '())))

(defun transform-all (pairs)
  (cond
    ((atom pairs) '())
    (true (cons (transform-pair (car pairs)) (transform-all (cdr pairs))))))

(let
  ((input '((a 1) (b 2) (c 3))))
  (transform-all input))             ; => 复制每个 pair

; --- 执行计划即数据 ---
(defun plan-stage (id deps op)
  (cons id (cons deps (cons op '()))))

(let
  ((plan
    (cons
      (plan-stage 'load-a '() 'load)
      (cons
        (plan-stage 'load-b '() 'load)
        (cons
          (plan-stage 'merge '(load-a load-b) 'concat)
          (cons
            (plan-stage 'embed '(merge) 'embed)
            '()))))))
  (car (car plan)))                  ; => Symbol("load-a")
