;; SCL 组件与算子模板
;; 展示未来 SCL 的组件定义、算子注册、能力策略等概念

; 组件：可复用的执行图模板

(component ingest-documents (source options)
  (pipeline
    (load source)
    (validate :schema "document")
    (chunk :size (get options :chunk-size 800))
    (embed :model (get options :embed-model "default"))
    (index :namespace (get options :namespace "documents"))))

(component search (query options)
  (pipeline
    (embed query :model (get options :embed-model "default"))
    (retrieve :top-k (get options :top-k 5))
    (rerank :model (get options :rerank-model nil))
    (format :template (get options :template "default"))))

(component etl-pipeline (source target transform-spec)
  (pipeline
    (extract source)
    (validate :spec transform-spec)
    (transform :spec transform-spec)
    (load target :mode "upsert")))

; 算子规格定义（用于 Python 互操作注册）
(op-spec
  (name "load")
  (category "io")
  (input (type "source-path"))
  (output (type "stream"))
  (effects "filesystem")
  (capabilities "filesystem:read"))

(op-spec
  (name "embed")
  (category "ml")
  (input (type "stream"))
  (output (type "stream"))
  (effects "network")
  (capabilities "network:api")
  (config
    (model "text-embedding-3-small")
    (dimensions 1536)))

(op-spec
  (name "index")
  (category "storage")
  (input (type "stream"))
  (output (type "confirmation"))
  (effects "network" "storage")
  (capabilities "network:api" "storage:write")
  (config
    (backend "vectorstore")
    (namespace "default")))

; 能力策略定义：沙箱环境
(capability-policy
  (name "sandbox")
  (rules
    (filesystem "read_only" :paths "/data/**")
    (network "allow" :hosts "api.openai.com")
    (compute "limited" :max-memory "512MB" :timeout "60s")
    (recursion true :max-depth 100)
    (macro false)))

; 能力策略定义：生产环境
(capability-policy
  (name "production")
  (rules
    (filesystem "read_write" :paths "/app/data/**")
    (network "allow" :hosts "*")
    (compute "unlimited")
    (recursion true)
    (macro true)))

; 模块定义
(module qy.core
  (exports
    (+ - * /)
    (car cdr cons atom eq)
    (quote cond defun))
  (imports
    (from qy.io (load save))
    (from qy.ml (embed classify))))

; 类型定义（未来特性）
(type-def
  (name "Document")
  (fields
    (id :type "string" :required true)
    (content :type "string" :required true)
    (metadata :type "(map string any)")
    (embedding :type "(vector float)" :optional true)))

(type-def
  (name "Chunk")
  (fields
    (text :type "string")
    (source-id :type "string")
    (offset :type "int")
    (length :type "int")))
