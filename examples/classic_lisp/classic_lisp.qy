;; 经典 Lisp 惯用法
;; 来自 McCarthy 原始 Lisp 论文的经典模式

; 1. car/cdr 组合访问器（经典 Lisp 命名）
(defun caar (x) (car (car x)))      ; 列表的列表的第一个元素
(defun cadr (x) (car (cdr x)))      ; 第二个元素
(defun cdar (x) (cdr (car x)))      ; 第一个子列表的尾部
(defun cddr (x) (cdr (cdr x)))      ; 去掉前两个元素
(defun caaar (x) (car (car (car x)))) ; 三层嵌套访问
(defun caddr (x) (car (cdr (cdr x)))) ; 第三个元素

; 2. 列表工具函数
(defun last (lst)
  (cond
    ((atom (cdr lst)) (car lst))    ; 只剩一个元素
    (true (last (cdr lst)))))       ; 继续向右

(last '(a b c d))                   ; => Symbol("d")

(defun butlast (lst)
  (cond
    ((atom (cdr lst)) '())          ; 只剩一个 => 返回空
    (true (cons (car lst) (butlast (cdr lst))))))

(butlast '(a b c d))                ; => '(a b c)

; 3. 配对：将两个列表元素一一配对
(defun pair (a b)
  (cond
    ((atom a) '())
    (true (cons (cons (car a) (car b)) (pair (cdr a) (cdr b))))))

(pair '(a b c) '(1 2 3))            ; => '((a . 1) (b . 2) (c . 3))

; 4. 关联列表（association list / alist）查找
(defun assoc (key alist)
  (cond
    ((atom alist) nil)              ; 空列表 => nil
    ((eq key (car (car alist))) (car alist))  ; 找到 => 返回整个 pair
    (true (assoc key (cdr alist)))))

(assoc 'b '((a 1) (b 2) (c 3)))    ; => (b 2)
(assoc 'z '((a 1) (b 2) (c 3)))    ; => nil

; 5. pairlis：从两个列表构建关联列表
(defun pairlis (keys vals)
  (cond
    ((atom keys) '())
    (true (cons (cons (car keys) (car vals))
                (pairlis (cdr keys) (cdr vals))))))

(pairlis '(a b c) '(1 2 3))         ; => '((a . 1) (b . 2) (c . 3))

; 6. 反向拼接：将列表追加到累加器前
(defun rev-append (lst acc)
  (cond
    ((atom lst) acc)
    (true (rev-append (cdr lst) (cons (car lst) acc)))))

(rev-append '(1 2 3 4) '())         ; => '(4 3 2 1)

; 7. 集合操作（基于 eq）
(defun member (x lst)
  (cond
    ((atom lst) false)
    ((eq x (car lst)) true)
    (true (member x (cdr lst)))))

(defun union (a b)
  (cond
    ((atom a) b)
    ((member (car a) b) (union (cdr a) b))  ; 已存在则跳过
    (true (cons (car a) (union (cdr a) b)))))

; 8. 树搜索：在嵌套列表中查找元素
(defun tree-member (x tree)
  (cond
    ((atom tree) (eq x tree))       ; 叶节点：直接比较
    ((eq x (car tree)) true)        ; 根节点匹配
    (true (cond
      ((tree-member x (car tree)) true)   ; 在左子树查找
      (true (tree-member x (cdr tree))))))); 在右子树查找

; 9. 镜像：列表正反拼接形成回文
(defun palindrome-h (lst acc)
  (cond
    ((atom lst) acc)
    (true (palindrome-h (cdr lst) (cons (car lst) acc)))))

(defun append (a b)
  (cond
    ((atom a) b)
    (true (cons (car a) (append (cdr a) b)))))

(defun mirror (lst)
  (append lst (palindrome-h lst '())))

(mirror '(a b c))                   ; => '(a b c c b a)

; 10. Church 数风格的加减乘（用数字模拟）
(defun zero-p (n) (eq n 0))
(defun succ (n) (+ n 1))
(defun pred (n) (- n 1))

(defun add-church (m n)
  (cond
    ((zero-p m) n)
    (true (succ (add-church (pred m) n)))))

(add-church 3 4)                    ; => 7

(defun mul-church (m n)
  (cond
    ((zero-p m) 0)
    (true (add-church n (mul-church (pred m) n)))))

(mul-church 3 5)                    ; => 15
