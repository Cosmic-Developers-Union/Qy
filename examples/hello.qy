; 由宏实现的 defun 版本
(macro defun-macro (name args &body body)
  `(define ,name
     (lambda ,args
       ,@body)))
(defun-macro simple-00 () (+ 1 2))
; 由 component 实现的 defun 版本
; component 是一个元算子, 它接收任意个算子, 并进行融合, 成为一个新算子
; 新算子的参数是所有输入算子的参数的组合, 在使用时, 依次传递
; 典型 f(x) = g(m(x)), (component g m) 就是一个新算子, 它的参数是 x, 在使用时传递 x 就行了
(define defun-component (component define lambda))
; 这是一个具名算子的标准实现
(define simple-01
  (lambda () (+ 1 2)))
(defun main ()
  (pipeline (simple-01)
    (handle
      (on divide-by-zero () k (resume k 1))
      (+ (/ 1 0) (/ 1 0)))))
(main)
(defeffect assert-failed)

; assert 是本文件内部使用的最小断言算子。
; condition 为真时直接返回 condition, 让断言表达式本身保持可组合。
; condition 为 false/nil 时不借用除零等宿主错误, 而是 perform 一个明确的
; assert-failed effect, 并把 message 作为失败原因传给 handler 或运行时。
(defun assert (condition message)
  (cond
    (condition condition)
    (true (perform assert-failed message))))

; quote 返回 syntax datum, 不触发 runtime lookup。
; car/cdr/cons 直接操作 chain, 因此这里展示的是 Qy 的 syntax datum / chain
; 数据模型, 而不是 Python list。
(assert (eq (car '(alpha beta gamma)) 'alpha) 'quote-car-keeps-symbol)
(assert (= (len (cdr '(alpha beta gamma))) 2) 'quote-cdr-keeps-chain-tail)
(assert (eq (car (cons 'head '(tail))) 'head) 'cons-builds-chain)

; atom 区分 atom 和非空 cons chain。
; symbol 是 atom, 空 chain/nil 是 atom, 非空 cons chain 不是 atom。
; 这个语义只针对 cons chain 的结构判断, 不把高级容器 list 当作 cons chain。
(assert (atom 'alpha) 'symbol-is-atom)
(assert (atom '()) 'empty-chain-is-atom)
(assert (eq (atom '(alpha)) false) 'non-empty-chain-is-not-atom)

; dotted pair 是 cons chain 的经典形态。
; '((a . 1) (b . 2)) 不是 array list, 而是由 cons cell 组成的 association chain。
; 每个 entry 本身也是 pair: car 是 key symbol, cdr 是 value symbol。
(assert (eq (car (car '((a . 1) (b . 2)))) 'a) 'alist-first-key)
(assert (eq (cdr (car '((a . 1) (b . 2)))) '1) 'alist-first-value)
(assert (eq (car (car (cdr '((a . 1) (b . 2))))) 'b) 'alist-second-key)

; list 是高级数据容器, 语义上是底层 array, 不等同于 cons chain。
; (list '(1 2 3)) 把 quoted cons chain 的元素收集到 array/list 容器中。
; 因此它可以用 len/get 按 array 方式观察, 同时对 atom 来说它不是 cons chain。
(assert (= (len (list '(1 2 3))) 3) 'list-converts-chain-to-array)
(assert (eq (get (list '(1 2 3)) 1) '2) 'list-array-indexes-second-item)
(assert (atom (list '(1 2 3))) 'list-array-is-not-cons-chain)

; map 是高级 key/value 容器示例。
; 这里用宏把 (map :a 1 :b 2) 展开成底层容器构造, 并显式 quote key,
; 让 :a 和 :b 保持为 Qy symbol key, 而不是被当成变量 lookup。
; 这个示例只覆盖两个 key/value pair, 用来展示目标语言形态。
(macro map (key-a value-a key-b value-b)
  (cons 'dict
    (cons
      (cons 'quote (cons key-a '()))
      (cons value-a
        (cons
          (cons 'quote (cons key-b '()))
          (cons value-b '()))))))
(assert (= (get (map :a 1 :b 2) ':b) 2) 'map-container-uses-symbol-keys)

; let 构造新的局部 symbol-space。
; 这里把 + shadow 成一个只返回 left 的函数, 证明当前 symbol-space 的 binding
; 会优先于外层 standard profile 中的同名 +。
(assert
  (=
    (let ((+ (lambda (left right) left)))
      (+ 42 0))
    42)
  'let-can-shadow-outer-plus)

; this 是当前 symbol-space 的显式入口。
; 它的求值结果不是某个全局环境, 而是当前求值点所在的 ss。
; 后续 slot/bind/define 都发生在这个 ss 上。
(assert (this) 'this-returns-current-symbol-space)

; slot 是无参算子, 每次调用都会在当前 ss 中申请一个新的槽位。
; 这个槽位是 binding 的承载位置, 本质上可以理解为一个 pair 结构:
; 一侧关联 symbol, 另一侧关联 value。
; slot 本身不决定名字和值, 它只提供“可以被绑定的空间”。
(define explicit-slot (slot))

; bind 把 symbol 与 value 绑定到指定 slot。
; (bind 'slot-bound 10 explicit-slot) 的意思是:
;   1. symbol slot-bound 指向 explicit-slot
;   2. value 10 也指向 explicit-slot
;   3. 后续求值 slot-bound 时, 通过这个 slot 读到 10
; 这里的第一个参数必须是 symbol datum, 因此使用 quote 写成 'slot-bound。
(bind 'slot-bound 10 explicit-slot)
(assert (= slot-bound 10) 'bind-attaches-symbol-and-value-to-slot)

; define 是 bind + slot 的标准语法糖。
; (define 'defined-through-slot 42) 等价于:
;   (bind 'defined-through-slot 42 (slot))
; 也就是说 define 不应该被理解成“修改变量表”, 而是创建 slot 并完成一次 binding。
(define 'defined-through-slot 42)
(assert (= defined-through-slot 42) 'define-is-bind-slot-sugar)

; apply 展示函数值和参数 chain 的动态调用。
; + 作为函数值传入, '(20 22) 作为参数 chain 展开后完成调用。
(assert (= (apply + '(20 22)) 42) 'apply-calls-function-with-chain-args)

; cond + tail call 展示控制流与函数调用路径。
; sum-to 的递归调用位于 tail position, 用来覆盖 VM 的函数调用与尾调用路径。
(defun sum-to (n acc)
  (cond
    ((= n 0) acc)
    (true (sum-to (- n 1) (+ acc n)))))
(assert (= (sum-to 10 0) 55) 'tail-recursive-sum)

; cond 的核心条件语义是 nil/false 为假, 其它 runtime value 为真。
; 这里分别展示 false 分支跳过、number 为真、symbol datum 为真、非空 chain 为真。
; 复杂真值判断可以由 truthy 这类 profile 算子扩展, 但不会改变 cond 的核心规则。
(assert (= (cond (false 0) (true 42)) 42) 'cond-skips-false)
(assert (= (cond (0 42) (true 0)) 42) 'cond-treats-number-as-true)
(assert (= (cond ('symbol-value 42) (true 0)) 42) 'cond-treats-symbol-as-true)
(assert (= (cond ('(x) 42) (true 0)) 42) 'cond-treats-non-empty-chain-as-true)

; 用户定义 effect + perform + handle + resume。
; perform ask 41 会捕获当前位置的 continuation。
; handler 收到 value 和 continuation k 后, 用 resume 把 42 注入回 perform 点。
(defeffect ask)
(assert
  (=
    (handle
      (on ask (value) k (resume k (+ value 1)))
      (perform ask 41))
    42)
  'effect-resume-produces-value)

; 同一个 continuation 可以被多次 resume, 这是 multi-shot continuation 的核心展示。
; perform choose 20 捕获的 continuation 是 (+ <perform-result> 1)。
; handler 第一次 resume k 20 得到 21, 第二次 resume k 21 得到 22。
; handler 把两次恢复结果相加, 因此最终结果是 43。
(defeffect choose)
(assert
  (=
    (handle
      (on choose (value) k
        (+ (resume k value) (resume k (+ value 1))))
      (+ (perform choose 20) 1))
    43)
  'continuation-can-be-resumed-more-than-once)

; assert-failed 本身也是普通 effect, 因此它可以被 handle 捕获。
; 这个示例故意触发一次失败断言, handler 不 resume, 而是直接返回 message。
; 外层 assert 再检查这个 message, 证明断言失败不是隐式崩溃, 而是显式 effect。
(assert
  (eq
    (handle
      (on assert-failed (message) k message)
      (assert false 'handled-assert-failure))
    'handled-assert-failure)
  'assert-failed-can-be-handled)

; failure-like effect 可以选择不恢复 continuation。
; stop-here 的 handler 忽略 k, 直接返回 value, 这展示了 effect handler 可以把
; 当前控制流截断为一个显式结果。
(defeffect stop-here)
(assert
  (=
    (handle
      (on stop-here (value) k value)
      (perform stop-here 42))
    42)
  'effect-handler-may-not-resume)

; defeffect 可以声明不可恢复 effect。
; :resumable false 表示该 effect 的 continuation 不允许被 resume。
; handler 可以像这里一样直接返回一个值, 把控制流结束在 handler 中。
(defeffect abort-now :resumable false)
(assert
  (=
    (handle
      (on abort-now (value) k value)
      (perform abort-now 42))
    42)
  'non-resumable-effect-returns-from-handler)

; quote / eval 闭环展示 syntax datum 可以重新进入求值。
; '(+ 20 22) 首先只是数据, eval 之后才按当前 symbol-space-chain 查找 + 并执行。
(assert (= (eval '(+ 20 22)) 42) 'quoted-form-can-be-evaluated)

; reify 是 eval 的反向边界: runtime value 可以在目标上下文中重新变成 syntax datum。
; 这里把 runtime number 42 reify 成 symbol 42, 再用 eq 按 symbol 值比较。
; 这强调 Qy 的 read/eval/reify 是三段关系, 不是 Python 对象 repr 的直接暴露。
(assert (eq (reify 42) '42) 'runtime-number-can-be-reified-to-symbol)
(assert (eq (car (reify '(alpha beta))) 'alpha) 'runtime-chain-can-be-reified)

; ordering / join: pipeline 固定顺序, parallel/all/race 表达组合控制。
; pipeline 返回最后一个表达式, parallel/all 返回多个分支结果, race 返回最先恢复的分支。
(assert (= (pipeline 1 2 3) 3) 'pipeline-returns-last-value)
(assert (= (len (parallel 1 2 3)) 3) 'parallel-returns-branch-results)
(assert (= (len (all 1 2 3)) 3) 'all-joins-branch-results)
(assert (race true true) 'race-returns-one-resumed-result)

; parallel/all 的结果本身可以继续被数据算子观察。
; parallel 是 order-insensitive 的求值组, 但它的返回容器仍保留每个分支结果。
; all 是 barrier continuation, 所有分支完成后才把结果交还给父 continuation。
; race 在单分支场景下结果确定, 多分支场景只保证 first-resume wins。
(assert (= (get (parallel 1 2 3) 1) 2) 'parallel-result-content-is-observable)
(assert (= (get (all 1 2 3) 2) 3) 'all-result-content-is-observable)
(assert (= (race 42) 42) 'race-single-branch-result-is-observable)

; effect 与 all/race 可以组合。
; join-token 的 handler 会 resume continuation, 因此 all 能等待每个分支恢复后的值。
; race 同样运行在 handler 的动态范围内, 第一个恢复的分支决定 race 的结果。
(defeffect join-token)
(assert
  (=
    (handle
      (on join-token (value) k (resume k (+ value 1)))
      (len (all (perform join-token 1) (perform join-token 2))))
    2)
  'all-can-join-handled-effects)
(assert
  (handle
    (on join-token (value) k (resume k true))
    (race (perform join-token 1) (perform join-token 2)))
  'race-can-return-handled-effect)

; module 建立 symbol-space, exports/from 控制 fold 到当前空间。
; triple 被 exports 暴露后, from 才能把它 fold 到当前 symbol-space。
(module hello.math
  (defun triple (value) (* value 3))
  (exports triple))
(from hello.math import triple)
(assert (= (triple 14) 42) 'module-export-imports-triple)

; from import 可以通过 alias 把导出的 binding fold 成当前 ss 中的另一个名字。
; alias 不改变源模块中的 binding, 只改变当前 symbol-space 接收这个 binding 时的本地名。
(from hello.math import (triple as times3))
(assert (= (times3 14) 42) 'from-import-alias-binds-local-name)

; exports 可以一次暴露多个 binding。
; from import 也可以一次选择多个导出项, 每个导入项都会 fold 到当前 symbol-space。
(module hello.multi-export
  (defun inc (value) (+ value 1))
  (defun double (value) (* value 2))
  (exports inc double))
(from hello.multi-export import inc double)
(assert (= (inc 41) 42) 'module-exports-first-binding)
(assert (= (double 21) 42) 'module-exports-second-binding)

; exports 是选择性视图。
; hidden-step 留在模块内部, public-answer 才被 exports 暴露。
; 当前文件只 import public-answer, 因此外部只依赖模块承诺导出的 binding。
(module hello.exports
  (defun hidden-step (value) (+ value 1))
  (defun public-answer (value) (* (hidden-step value) 2))
  (exports public-answer))
(from hello.exports import public-answer)
(assert (= (public-answer 20) 42) 'module-exports-hide-internal-helper)

; module 也可以导出宏。
; 这里 answer-form 是 compile-time macro, from import 后可以在调用点展开。
; 宏导出只进入宏展开阶段的 namespace, 不应该污染 runtime value namespace。
(module hello.macro-export
  (macro answer-form ()
    '42)
  (exports answer-form))
(from hello.macro-export import answer-form)
(assert (= (answer-form) 42) 'module-can-export-macro)

; macro hygiene 默认保护 call-site binding, capture 用于显式捕获。
; with-temp 在宏展开中构造一个 let, 但不会捕获调用点已有的 tmp。
; add-one 使用普通 '+, 因此保持 definition-site 的 +。
; call-site-plus 使用 capture '+, 因此显式选择调用点 shadow 后的 +。
; gensym 可以在宏展开期生成一个不会和调用点冲突的新 symbol。
; bind-once 先生成私有 binding 名, 再在展开结果中同时用于 let binding 和引用位置。
(macro with-temp (expr)
  (cons 'let
    (cons
      (cons (cons 'tmp (cons 1 '())) '())
      (cons expr '()))))
(macro add-one (value)
  (cons '+ (cons value (cons 1 '()))))
(macro call-site-plus (value)
  (cons (capture '+) (cons value (cons 1 '()))))
(macro bind-once (value)
  (let ((name (gensym)))
    `(let ((,name ,value))
       ,name)))
(assert (= (let ((tmp 99)) (with-temp tmp)) 99) 'macro-hygiene-keeps-call-site-tmp)
(assert (= (let ((+ (lambda (left right) 0))) (add-one 41)) 42) 'macro-keeps-definition-site-plus)
(assert (= (let ((+ (lambda (left right) 0))) (call-site-plus 41)) 0) 'macro-capture-uses-call-site-plus)
(assert (= (bind-once (+ 20 22)) 42) 'gensym-creates-private-macro-binding)

; 以下是错误/effort 的目标语言形态, 它们是工具链和 handler 应该理解的控制点。
; golden file 主路径不直接执行这些必失败表达式, 但保留它们作为核心语义说明。
;
; unresolved-symbol effort:
;   (handle
;     (on unresolved-symbol (name) k name)
;     missing-name)
;
; pending-binding / incomplete-value effort:
;   (pipeline
;     pending-name
;     (define pending-name 42))
;
; unsupported-operation effort:
;   (handle
;     (on unsupported-operation (op) k op)
;     (+ 'symbol-value 1))
