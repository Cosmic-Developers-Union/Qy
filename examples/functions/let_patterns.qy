;; let 高级模式
;; 展示 let 与递归、闭包、管道式计算的组合用法

; let + 递归：命名中间结果
(defun sum-list (lst)
  (cond
    ((atom lst) 0)
    (true (+ (car lst) (sum-list (cdr lst))))))

(let
  ((data '(10 20 30 40 50)))
  (sum-list data))                  ; => 150

; let 缓存递归结果
(defun factorial (n)
  (cond
    ((eq n 0) 1)
    (true (* n (factorial (- n 1))))))

(let
  ((n 10)
   (result (factorial 10)))
  result)                           ; => 3628800

; 模拟解构：用辅助函数提取 pair 中的元素
(defun first-of (pair) (car pair))
(defun second-of (pair) (car (cdr pair)))

(let
  ((point '(3 4)))
  (let
    ((x (first-of point))
     (y (second-of point)))
    (+ (* x x) (* y y))))           ; => 9 + 16 = 25（勾股定理）

; let 做结果缓存
(let
  ((expensive (factorial 20)))
  (+ expensive (- expensive 0)))    ; 多次使用同一计算结果

; 高阶模式：函数作为参数传递（通过 defun 间接实现）
(defun apply-twice (f x) (f (f x)))
(defun add5 (x) (+ x 5))

(let
  ((result (apply-twice add5 10)))
  result)                           ; => 20

; 管道式计算：用嵌套 let 模拟链式处理
(let
  ((raw '(1 2 3 4 5)))
  (let
    ((len (sum-list raw)))
    (let
      ((avg (/ len 5)))
      avg)))                        ; => 3.0（平均值）

; let + 谓词：条件判断
(defun is-empty (lst) (eq lst '()))

(let
  ((items '()))
  (cond
    ((is-empty items) 'empty)
    (true 'not-empty)))             ; => 'empty

(let
  ((items '(a b)))
  (cond
    ((is-empty items) 'empty)
    (true 'not-empty)))             ; => 'not-empty

; let + defun 创建闭包（函数捕获外层变量）
(let
  ((base 10))
  (defun offset (x) (+ x base))
  (offset 5))                       ; => 15

; let 处理嵌套列表
(defun reverse (lst)
  (defun rev-h (lst acc)
    (cond
      ((atom lst) acc)
      (true (rev-h (cdr lst) (cons (car lst) acc)))))
  (rev-h lst '()))

(let
  ((original '(a b c d e))
   (reversed (reverse '(a b c d e))))
  (cons original (cons reversed '())))  ; => 原始列表和反转列表组成的 pair
