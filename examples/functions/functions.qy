;; 函数定义（defun）
;; defun 是语法操作符（SyntaxOperator），不预先求值参数，直接创建函数

; 简单函数
(defun square (x) (* x x))        ; 平方
(defun double (x) (* x 2))        ; 两倍
(defun add (a b) (+ a b))         ; 加法
(defun subtract (a b) (- a b))    ; 减法

; 多 body 表单（返回最后一个表达式的值）
(defun first-of (x y) x)          ; 返回第一个参数
(defun second-of (x y) y)         ; 返回第二个参数
(defun third-of-three (x y z) x y z)  ; 返回 z

; 函数组合：在函数体内调用其他函数
(defun add-one (x) (+ x 1))
(defun add-two (x) (+ x 2))
(defun add-both (x) (add-one (add-two x)))  ; x + 2 + 1

; 在表达式中使用函数
(+ (square 3) (square 4))         ; => 9 + 16 = 25
(* (double 5) (double 6))         ; => 10 * 12 = 120
(add (square 3) (double 7))       ; => 9 + 14 = 23

; 嵌套调用：函数返回值作为另一个函数的参数
(defun compose-add (x) (+ x 10))
(defun use-composed (x) (compose-add (compose-add x)))  ; => x + 20

; 累加器模式：通过辅助参数积累结果
(defun replicate-helper (n acc)
  (cond
    ((eq n 0) acc)
    (true (replicate-helper (- n 1) (cons 'x acc)))))

; 恒等函数与常量函数
(defun identity (x) x)            ; 返回参数本身
(defun always-42 (ignored) 42)    ; 忽略参数，返回常量
(defun const (x y) x)             ; 返回第一个参数
