;; let：词法作用域与局部绑定
;; let 创建新的局部环境，绑定符号到值，然后在环境中求值 body

; 基本用法：绑定多个值
(let
  ((x 10)
   (y 20))
  (+ x y))                          ; => 30

; 绑定中可以使用表达式
(let
  ((a (+ 1 2))
   (b (* 3 4)))
  (+ a b))                          ; => 3 + 12 = 15

; 变量遮蔽：内层 let 可以遮蔽外层同名变量
(let
  ((x 100))
  (let
    ((x 200))
    x))                             ; => 200（内层 x 遮蔽外层）

; let 不影响外层作用域
(let
  ((x 100))
  (let
    ((x 200))
    x)                              ; 内层 x = 200
  x)                                ; 外层 x 仍为 100

; let 结合列表操作
(let
  ((items '(a b c d)))
  (car items))                      ; => Symbol("a")

(let
  ((items '(a b c d)))
  (cdr items))                      ; => (Symbol("b"), Symbol("c"), Symbol("d"))

(let
  ((items '(a b c d)))
  (cons 'z items))                  ; => '(z a b c d)

; let 结合函数调用
(defun square (x) (* x x))
(let
  ((a 5)
   (b (square 3)))
  (+ a b))                          ; => 5 + 9 = 14

; let 结合 cond
(let
  ((x 10))
  (cond
    ((eq x 10) 'ten)
    (true 'other)))                 ; => 'ten

; 嵌套 let：逐步计算
(let
  ((x 1))
  (let
    ((y (+ x 1)))
    (let
      ((z (+ y 1)))
      (+ x y z))))                  ; => 1 + 2 + 3 = 6

; 覆盖内置字面量：在局部作用域中重新定义 1 和 2
(let
  ((1 10)
   (2 20))
  (+ 1 2))                          ; => 30（局部绑定优先于内置转换）

; 空绑定列表
(let
  ()
  42)                               ; => 42

; 多 body 表单（返回最后一个）
(let
  ((x 1))
  x                                 ; x = 1
  (+ x 1)                           ; 2（被忽略）
  (* x 10))                         ; => 10

; 绑定引用符号
(let
  ((name 'hello))
  name)                             ; => Symbol("hello")

; let 内部定义函数（闭包捕获 let 绑定的值）
(let
  ((double (defun d (x) (* x 2))))
  (double 21))                      ; => 42

; 链式 let：类似管道式计算
(let
  ((step1 (+ 1 2)))                 ; step1 = 3
  (let
    ((step2 (* step1 step1)))       ; step2 = 9
    (let
      ((step3 (+ step2 10)))        ; step3 = 19
      step3)))                      ; => 19

; let 构建列表
(let
  ((a 'x)
   (b 'y)
   (c 'z))
  (cons a (cons b (cons c '()))))   ; => '(x y z)
