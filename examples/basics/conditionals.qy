;; 条件表达式（cond）
;; cond 依次检查条件分支，返回第一个为真的分支的值

; 基本条件
(cond (true 1) (false 2))           ; => 1（第一个分支匹配）
(cond (false 1) (true 2))           ; => 2（跳过第一个分支）
(cond (false 1) (false 2) (true 3)) ; => 3（多分支）

; 无匹配时返回 nil
(cond (false 1) (false 2))          ; => nil

; 条件分支中的表达式会被求值
(cond (true (+ 1 2)) (false (* 3 4)))   ; => 3
(cond (false (+ 1 2)) (true (* 3 4)))   ; => 12

; 嵌套 cond
(cond
  (false (cond (true 1) (false 2))) ; 内层 cond 被跳过
  (true 99))                         ; => 99

; 结合 eq 做模式匹配风格的条件判断
(cond
  ((eq 'a 'b) "a equals b")         ; 不匹配
  ((eq 'a 'a) "a equals a")         ; 匹配 => "a equals a"
  (true "no match"))                 ; 默认分支

; 布尔逻辑：cond 可用于模拟 if-else
(cond (true 'yes) (false 'no))      ; => 'yes

; 真值规则：除 false、nil、空列表外，一切皆为真
(cond ('something 'truthy) (false 'falsy))  ; => 'truthy
(cond (() 'truthy) (true 'falsy))           ; => 'falsy（空列表为假）
