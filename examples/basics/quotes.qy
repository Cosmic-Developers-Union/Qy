;; 引用（Quote）与符号（Symbol）
;; quote 阻止求值，将表达式作为符号数据返回

; 基本引用：'expr 是 (quote expr) 的语法糖
'abc                        ; => Symbol("abc")，不查找环境
'123                        ; => Symbol("123")，不求值为数字 123
'(a b c)                    ; => 符号列表，不执行函数调用
(quote hello)               ; 等价于 'hello
(quote (nested list here))  ; => 嵌套符号列表

; 符号相等性：同名符号相等
(eq 'abc 'abc)              ; => true
(eq 'abc 'def)              ; => false

; 列表不相等（结构比较，非值比较）
(eq '(a b) '(a b))          ; => false

; 空列表相等
(eq '() '())                ; => true

; atom 判断：非空列表以外的值都是 atom
(atom 'abc)                 ; => true（符号是 atom）
(atom '123)                 ; => true（符号是 atom）
(atom '(a b c))             ; => false（非空列表不是 atom）
(atom '())                  ; => true（空列表被视为 atom）

; 嵌套引用
(quote (quote x))           ; => (quote x)，外层 quote 阻止内层求值
(car '(a b c))              ; => Symbol("a")
(car (quote (hello world))) ; => Symbol("hello")
