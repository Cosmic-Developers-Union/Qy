;; 列表操作
;; Qy 的列表用 tuple 表示，提供 car/cdr/cons 三个核心操作

; car：取列表第一个元素
(car '(a b c))              ; => Symbol("a")
(car '((x y) (z w)))        ; => (Symbol("x"), Symbol("y"))
(car '(only))               ; => Symbol("only")

; cdr：取列表除第一个元素外的剩余部分
(cdr '(a b c))              ; => (Symbol("b"), Symbol("c"))
(cdr '(a b))                ; => (Symbol("b"),)
(cdr '(a))                  ; => ()，空列表

; cons：在列表头部添加元素
(cons 'a '(b c))            ; => (Symbol("a"), Symbol("b"), Symbol("c"))
(cons '(a b) '(c d))        ; => ((Symbol("a"), Symbol("b")), Symbol("c"), Symbol("d"))
(cons 'x '())               ; => (Symbol("x"),)，从空列表构造单元素列表

; 从空列表逐步构建列表
(cons 'a (cons 'b (cons 'c '())))  ; => '(a b c)

; 链式 car/cdr：访问深层元素
(car (cdr '(a b c d)))          ; => Symbol("b")（第二个元素）
(cdr (cdr '(a b c d)))          ; => (Symbol("c"), Symbol("d"))（去掉前两个）
(car (cdr (cdr '(a b c d))))    ; => Symbol("c")（第三个元素）

; 分解后重组
(cons (car '(x y z)) (cdr '(x y z)))  ; => '(x y z)，拆开再拼回

; 嵌套列表操作
(car (car '((a b) c d)))       ; => Symbol("a")（取第一个子列表的第一个元素）
(cdr (cdr '(1 (2 3) 4)))       ; => (4,)（去掉前两个元素）
