;; 字符串与符号
;; Qy 中字符串本质是带引号的符号，Reader 保留原始文本信息

; 双引号符号（支持转义）
"hello world"               ; 包含空格的符号
"contains \"quotes\""       ; 转义双引号
"has\nnewlines"             ; 转义换行
"backslash: \\"             ; 转义反斜杠
"unicode: \u4e2d\u6587"     ; Unicode 转义 => 中文

; 原始引号符号（r 前缀，不处理转义）
r"\d+\s+[a-z]+"             ; 正则表达式，\d 保持原样
r"C:\Users\name\Documents"  ; Windows 路径，\ 不转义
r"\n is literal, not newline"; \n 是字面量，不是换行

; 多行符号（三引号）
"""
This is a
multiline
symbol
"""

"""
Line one
Line two
Line three
"""

; 原始多行符号（r + 三引号，适合正则和路径）
r"""
\d+\.\d+
[a-zA-Z_]\w*
C:\path\to\file
"""

; 裸符号中的特殊字符
:keyword                    ; 关键字风格符号
///path/to/resource         ; 路径风格符号
model:gpt-4.1               ; 冒号分隔的命名符号
ns/item                     ; 斜杠分隔的命名空间符号

; 符号中的点和斜杠
a.b.c                       ; 点分隔符号
x/y/z                       ; 路径风格
v1.2.3                      ; 版本号

; 在列表中使用引号符号
(path "/usr/local/bin")                         ; 文件路径
(query "SELECT * FROM users WHERE active = true") ; SQL 查询
(regex r"^[a-z]+$")                             ; 正则表达式
(template """
Dear {name},
Welcome to {platform}.
""")                                            ; 模板字符串
