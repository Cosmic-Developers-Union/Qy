; 跨宿主标准原语：string->number / number? / remainder；qy.char 字符算子；eq 对 char 按值。
(from qy.char import char? char=? char<? char->integer integer->char char->string char-upcase char-alphabetic? char-numeric? char-whitespace?)
(from qy.num import number? remainder)
(from qy.str import string-length string-slice string-at string-find string-replace string-split)
(from qy.int8 import int8 int8? / mod rem bit-and bit-not min-value max-value bits)
(from qy.io import display newline)
(pipeline
  (= (string->number "42") 42)
  (= (string->number "3.5") 3.5)
  (= (string->number "1_000") 1000)
  (eq (string->number "nope") nil)
  (number? 42)
  (number? 3.5)
  (eq (number? "a") nil)
  (= (remainder -7 3) -1)
  (= (remainder 7 -3) 1)
  (= (remainder -7.0 3.0) -1.0)
  (= (remainder 7.0 -3.0) 1.0)
  (char? #\A)
  (char=? (integer->char 66) #\B)
  (char<? #\A #\B)
  (= (char->integer #\A) 65)
  (char-alphabetic? #\a)
  (char-numeric? #\5)
  (char-whitespace? #\space)
  (eq (char->string #\a) "a")
  (char=? (char-upcase #\a) #\A)
  (eq (type #\a) 'char)
  (eq (type car) 'operator)
  (eq (type (lambda (x) x)) 'function)
  (eq (type (defeffect ask)) 'effect)
  (eq (eq #\a #\b) nil)
  (eq (eq #\a 1.0) nil)
  (int8? (int8 5))
  (= (bit-and (int8 12) (int8 10)) (int8 8))
  (= (bit-not (int8 0)) (int8 -1))
  (= min-value (int8 -128))
  (= max-value (int8 127))
  (= bits 8)
  ; 类型化整数：`/` 向零截断、`mod` floored、`rem` 截断（与 qy.num 一致）。
  (= (/ (int8 -7) (int8 3)) (int8 -2))
  (= (mod (int8 -7) (int8 3)) (int8 2))
  (= (rem (int8 -7) (int8 3)) (int8 -1))
  ; 字符串索引按 code point（astral 字符不拆分 surrogate）。
  (= (string-length "😀é") 2)
  (eq (string-slice "😀ab" 0 1) "😀")
  (= (char->integer (string-at "😀" 0)) 128512)
  (= (string-find "😀ab" "b") 2)
  (eq (string-replace "abc" "" "-") "-a-b-c-")
  ; 可选参数缺省：无 separator 的 split、只有 start 的 slice。
  (eq (string-split "a b  c") (tuple "a" "b" "c"))
  (eq (string-slice "abc" 1) "bc")
  (eq (string-slice "abc" 1 2) "b")
  ; get/has? 的默认值与容器。
  (= (get (dict 'a 1) 'b 42) 42)
  (= (get '(1 2 3) 1) 2)
  (has? (set 1 2) 2)
  (display #\a)
  (newline)
  (eq #\a #\a))
