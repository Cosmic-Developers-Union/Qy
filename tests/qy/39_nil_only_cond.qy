; cond nil-only truth: only nil is false
(= (cond (nil 1) (true 2)) 2)

; 0 is truthy in nil-only semantics
(= (cond (0 'yes) (true 'no)) 'yes)

; Python False is truthy in nil-only semantics (use truthy for complex check)
(= (cond (false 1) (true 2)) 2)

; empty tuple is truthy
(= (cond (() 'yes) (true 'no)) 'yes)

; cond default returns nil
(= (cond (nil 1)) nil)

; truthy operator returns T for numbers
(= (truthy 0) T)
(= (truthy 1) T)
(= (truthy "") T)
(= (truthy nil) nil)
(= (truthy false) nil)
(= (truthy none) nil)
