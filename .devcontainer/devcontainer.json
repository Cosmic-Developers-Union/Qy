{
  "name": "QyLang",
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "workspaceFolder": "/workspaces/Qy",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "init": true,
  "remoteUser": "${localEnv:USER}",
  "updateRemoteUserUID": true,
  "containerEnv": {
    "GOROOT": "/usr/local/go",
    "GOPATH": "/home/${localEnv:USER}/go",
    "GOPROXY": "https://goproxy.cn,direct",
    "GOSUMDB": "sum.golang.google.cn",
    "GOTOOLCHAIN": "local",
    "LLVM_CONFIG": "llvm-config",
    "QY_CC": "clang",
    "QY_LLVM_DIR": "/usr/bin",
    "QY_LLC": "llc",
    "UV_LINK_MODE": "copy"
  },
  "remoteEnv": {
    "GOROOT": "/usr/local/go",
    "GOPATH": "/home/${localEnv:USER}/go",
    "GOPROXY": "https://goproxy.cn,direct",
    "GOSUMDB": "sum.golang.google.cn",
    "GOTOOLCHAIN": "local",
    "LLVM_CONFIG": "llvm-config",
    "QY_CC": "clang",
    "QY_LLVM_DIR": "/usr/bin",
    "QY_LLC": "llc",
    "SHELL": "/usr/bin/zsh",
    "PATH": "${containerWorkspaceFolder}/.venv/bin:${containerWorkspaceFolder}/node_modules/.bin:${containerEnv:GOROOT}/bin:${containerEnv:GOPATH}/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "ruff.nativeServer": "on",
        "go.goproxy": "https://goproxy.cn,direct",
        "go.toolsManagement.autoUpdate": true,
        "clangd.arguments": [
          "--background-index",
          "--clang-tidy",
          "--completion-style=detailed"
        ],
        "clangd.path": "/usr/bin/clangd",
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": {
            "path": "/usr/bin/zsh"
          }
        }
      },
      "extensions": [
        "charliermarsh.ruff",
        "golang.go",
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb"
      ]
    },
    "jetbrains": {
      "backend": "IntelliJ",
      "settings": {
        "com.intellij:app:HttpConfigurable.use_http_proxy": true,
        "com.intellij:app:HttpConfigurable.proxy_type_is_socks": true,
        "com.intellij:app:HttpConfigurable.proxy_host": "host.docker.internal",
        "com.intellij:app:HttpConfigurable.proxy_port": 1080,
        "com.intellij:app:HttpConfigurable.proxy_exceptions": "127.0.0.1, localhost, 192.168.*",
        "com.intellij:app:BaseRefactoringSettings.safe_delete_when_delete": false,
        "com.intellij:app:BaseRefactoringSettings.rename_search_in_comments_for_file": false,
        "com.intellij:app:BaseRefactoringSettings.rename_search_for_text_for_file": false,
        "com.intellij:app:BaseRefactoringSettings.rename_search_for_references_for_file": false,
        "com.intellij:app:BaseRefactoringSettings.rename_search_for_references_for_directory": false,
        "com.intellij:app:BaseRefactoringSettings.move_search_for_references_for_file": false
      },
      "plugins": []
    }
  }
}
