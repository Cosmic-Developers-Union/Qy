{
  "main": "./dist/extension.cjs",
  "module": "index.ts",
  "dependencies": {
    "@types/vscode": "^1.118.0",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "type": "module",
  "scripts": {
    "dev": "echo 'Open this directory in VSCode and then run your extension with F5 or `Run and Debug > Run Extension`!'",
    "build": "bun run ./scripts/build-with-esbuild.ts",
    "watch": "bun run ./scripts/watch-with-esbuild.ts",
    "vsce-package": "bun run vsce package",
    "package": "bun run build && bun run vsce-package",
    "clean": "rm -r ./dist"
  },
  "name": "qylang-support",
  "publisher": "Cosmic-Developers-Union",
  "version": "0.0.1",
  "description": "All-in-one support for QyLang: type checking, diagnostics, completions, hover, and formatting via LSP.",
  "displayName": "QyLang Support",
  "license": "Apache-2.0",
  "categories": ["Programming Languages", "Linters", "Formatters"],
  "keywords": ["qy", "qylang", "lisp"],
  "repository": {
    "type": "git",
    "url": "https://github.com/Cosmic-Developers-Union/Qy"
  },
  "engines": {
    "vscode": "^1.86.0"
  },
  "activationEvents": ["onLanguage:qy"],
  "contributes": {
    "languages": [
      {
        "id": "qy",
        "aliases": ["Qy", "QyLang"],
        "extensions": [".qy"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "qy",
        "scopeName": "source.qy",
        "path": "./syntaxes/qylang.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "QyLang",
      "properties": {
        "qylang.path": {
          "type": "string",
          "default": "qy",
          "description": "Path to the qy executable."
        },
        "qylang.format.lineWidth": {
          "type": "number",
          "default": 80,
          "description": "Maximum line width for formatting."
        },
        "qylang.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Traces the communication between VS Code and the QyLang language server."
        }
      }
    },
    "configurationDefaults": {
      "[qy]": {
        "editor.defaultFormatter": "Cosmic-Developers-Union.qylang-support",
        "editor.formatOnSave": true,
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.autoClosingBrackets": "always",
        "editor.wordSeparators": "()[]{}'\";,"
      }
    },
    "commands": [
      {
        "command": "qylang.restartServer",
        "title": "QyLang: Restart Language Server"
      }
    ]
  }
}
