;; meta-interp/main.qy — Qy meta-circular interpreter written in Qy.
;;
;; Interpreted subset:
;;   datum:        symbol / chain / number / string / nil
;;   special:      quote if cond define defun lambda let and or from apply
;;                 pipeline parallel all race module exports macro quasiquote
;;                 unquote unquote-splicing eval reify bind this component
;;   effects:      defeffect perform handle resume (resumable, continue semantics;
;;                 multi-shot continuations supported)
;;   macros:       hygiene by binder renaming + definition-site free symbols +
;;                 capture/gensym; reader supports dotted pairs
;;   numbers:      parsed through host `string->number` (int and float literals)
;;   primitives:   + - * / mod = == < > <= >= car cdr cons list get dict len
;;                 null? not eq? eq atom truthy is print slot
;;   other host operators resolve via `from` + `lookup-export` pass-through.
;;   reader:       `;` line comments, `'` quote, `` ` ``/`,`/`,@`,
;;                 string escapes (\n \t \r \" \\), triple-quoted strings
;;
;; Design:
;;   - tokens are chains (TAG payload); TAG ∈ SYM NUM STR LPAREN RPAREN QUOTE
;;   - env is a chain of frames; each frame is a chain of (name . value) pairs
;;   - evaluator is CPS: continuations are closures (lambda (value env ctx) ...)
;;     and ctx carries the dynamic handler stack plus resume targets
;;   - closures are chains (CLOSURE params body env name)
;;   - closure body env starts with a (FALLBACK globals) marker so references to
;;     globals defined after the closure was created (forward/mutual recursion)
;;     resolve at call time, mirroring pre-declared binding slots
;;   - results are printed after all forms are evaluated, matching `qy run`

(from qy.str import
  string-empty? string-slice string-length string-at
  string= string-concat string->symbol symbol->string)
(from qy.char import
  char-whitespace? char-numeric? char=? char->integer integer->char)
(from qy.core import type atom tuple)
(from qy.core import len truthy is list get dict)
(from qy.num import + -)
(from qy.num import / mod)
(from qy.num import =)
(from qy.num import ==)
(from qy.num import string->number)
(from qy.num import >)
(from qy.num import <)
(from qy.num import <=)
(from qy.num import >=)
(from qy.ext.fs import read-file)
(from qy.ext.interp import cli-args lookup-export display raise-error gensym)

;; === list helpers ===
(define reverse
  (lambda (items) (reverse-acc items nil)))

(define reverse-acc
  (lambda (items acc)
    (cond
      ((eq items nil) acc)
      (true (reverse-acc (cdr items) (cons (car items) acc))))))

;; === character code helper ===
(define chr
  (lambda (n) (integer->char n)))

;; === token accessors ===
(define tok-make
  (lambda (tag payload) (cons tag (cons payload nil))))

(define tok-tag
  (lambda (tok) (car tok)))

(define tok-payload
  (lambda (tok) (car (cdr tok))))

;; === tokenizer ===
(define tokenize-string
  (lambda (src)
    (tokenize-loop src 0 (string-length src) nil)))

(define skip-space
  (lambda (src i n)
    (cond
      ((>= i n) i)
      ((char-whitespace? (string-at src i)) (skip-space src (+ i 1) n))
      (true i))))

(define skip-line-comment
  (lambda (src i n)
    (cond
      ((>= i n) i)
      ((char=? (string-at src i) (chr 10)) (+ i 1))
      (true (skip-line-comment src (+ i 1) n)))))

(define delimiter?
  (lambda (ch)
    (cond
      ((char-whitespace? ch) true)
      ((char=? ch (chr 40)) true)
      ((char=? ch (chr 41)) true)
      ((char=? ch (chr 34)) true)
      ((char=? ch (chr 39)) true)
      ((char=? ch (chr 59)) true)
      ((char=? ch (chr 96)) true)
      ((char=? ch (chr 44)) true)
      ((char=? ch (chr 64)) true)
      (true nil))))

(define find-atom-end
  (lambda (src i n)
    (cond
      ((>= i n) i)
      ((delimiter? (string-at src i)) i)
      (true (find-atom-end src (+ i 1) n)))))

(define tokenize-atom
  (lambda (src i n acc)
    (let ((end (find-atom-end src i n)))
      (let ((text (string-slice src i end)))
        (cond
          ((dot-text? text)
           (tokenize-loop src end n (cons (tok-make 'DOT ".") acc)))
          (true
           (let ((number (string->number text)))
             (cond
               ((eq number nil)
                (tokenize-loop src end n (cons (tok-make 'SYM text) acc)))
               (true
                (tokenize-loop src end n (cons (tok-make 'NUM number) acc)))))))))))

(define dot-text?
  (lambda (text)
    (cond
      ((eq (string-length text) 1)
       (char=? (string-at text 0) (chr 46)))
      (true nil))))

(define scan-string
  (lambda (src i n acc)
    (cond
      ((>= i n) (cons acc n))
      ((char=? (string-at src i) (chr 34)) (cons acc i))
      ((char=? (string-at src i) (chr 92))
       (cond
         ((>= (+ i 1) n) (cons (string-concat acc "\\") n))
         (true (scan-string src (+ i 2) n
                            (string-concat acc (string-escape src (+ i 1)))))))
      (true (scan-string src (+ i 1) n
                         (string-concat acc (string-slice src i (+ i 1))))))))

(define string-escape
  (lambda (src i)
    (let ((ch (string-at src i)))
      (cond
        ((char=? ch (chr 110)) "\n")
        ((char=? ch (chr 116)) "\t")
        ((char=? ch (chr 114)) "\r")
        (true (string-slice src i (+ i 1)))))))

(define tokenize-string-token
  (lambda (src i n acc)
    (let ((r (scan-string src i n "")))
      (tokenize-loop src (+ (cdr r) 1) n
                     (cons (tok-make 'STR (car r)) acc)))))

(define triple-quote-at?
  (lambda (src i n)
    (cond
      ((>= (+ i 1) n) nil)
      ((char=? (string-at src i) (chr 34))
       (char=? (string-at src (+ i 1)) (chr 34)))
      (true nil))))

(define scan-string-triple
  (lambda (src i n acc)
    (cond
      ((>= (+ i 2) n) (cons (string-concat acc (string-slice src i n)) n))
      ((triple-quote-at? src i n) (cons acc (+ i 3)))
      ((char=? (string-at src i) (chr 92))
       (cond
         ((>= (+ i 1) n) (cons (string-concat acc "\\") (+ i 1)))
         (true (scan-string-triple src (+ i 2) n
                                   (string-concat acc (string-escape src (+ i 1)))))))
      (true (scan-string-triple src (+ i 1) n
                                (string-concat acc (string-slice src i (+ i 1))))))))

(define tokenize-loop
  (lambda (src i n acc)
    (let ((i (skip-space src i n)))
      (cond
        ((>= i n) (reverse acc))
        (true
          (let ((ch (string-at src i)))
            (cond
              ((char=? ch (chr 40))
               (tokenize-loop src (+ i 1) n (cons (tok-make 'LPAREN "(") acc)))
              ((char=? ch (chr 41))
               (tokenize-loop src (+ i 1) n (cons (tok-make 'RPAREN ")") acc)))
              ((char=? ch (chr 39))
               (tokenize-loop src (+ i 1) n (cons (tok-make 'QUOTE "'") acc)))
              ((char=? ch (chr 96))
               (tokenize-loop src (+ i 1) n (cons (tok-make 'QUASIQUOTE "`") acc)))
              ((char=? ch (chr 44))
               (cond
                 ((< (+ i 1) n)
                  (cond
                    ((char=? (string-at src (+ i 1)) (chr 64))
                     (tokenize-loop src (+ i 2) n
                                    (cons (tok-make 'UNQUOTE-SPLICING ",@") acc)))
                    (true
                     (tokenize-loop src (+ i 1) n (cons (tok-make 'UNQUOTE ",") acc)))))
                 (true
                  (tokenize-loop src (+ i 1) n (cons (tok-make 'UNQUOTE ",") acc)))))
              ((char=? ch (chr 34))
               (cond
                 ((triple-quote-at? src (+ i 1) n)
                  (let ((r (scan-string-triple src (+ i 3) n "")))
                    (tokenize-loop src (cdr r) n
                                   (cons (tok-make 'STR (car r)) acc))))
                 (true
                  (tokenize-string-token src (+ i 1) n acc))))
              ((char=? ch (chr 59))
               (tokenize-loop src (skip-line-comment src (+ i 1) n) n acc))
              (true (tokenize-atom src i n acc)))))))))

;; === parser: tokens -> syntax datum ===
(define parse-all
  (lambda (tokens)
    (parse-all-acc tokens nil)))

(define parse-all-acc
  (lambda (tokens acc)
    (cond
      ((eq tokens nil) (reverse acc))
      (true
        (let ((r (parse-one tokens)))
          (parse-all-acc (cdr r) (cons (car r) acc)))))))

(define parse-one
  (lambda (tokens)
    (let ((tok (car tokens)))
      (cond
        ((eq (tok-tag tok) 'LPAREN) (parse-list (cdr tokens) nil))
        ((eq (tok-tag tok) 'RPAREN) (cons nil (cdr tokens)))
        ((eq (tok-tag tok) 'QUOTE) (wrap-parse-one 'quote (cdr tokens)))
        ((eq (tok-tag tok) 'QUASIQUOTE) (wrap-parse-one 'quasiquote (cdr tokens)))
        ((eq (tok-tag tok) 'UNQUOTE) (wrap-parse-one 'unquote (cdr tokens)))
        ((eq (tok-tag tok) 'UNQUOTE-SPLICING)
         (wrap-parse-one 'unquote-splicing (cdr tokens)))
        ((eq (tok-tag tok) 'SYM)
         (cons (string->symbol (tok-payload tok)) (cdr tokens)))
        ((eq (tok-tag tok) 'NUM)
         (cons (tok-payload tok) (cdr tokens)))
        ((eq (tok-tag tok) 'STR)
         (cons (tok-payload tok) (cdr tokens)))
        (true (cons nil (cdr tokens)))))))

(define wrap-parse-one
  (lambda (head tokens)
    (let ((r (parse-one tokens)))
      (cons (cons head (cons (car r) nil)) (cdr r)))))

(define parse-list
  (lambda (tokens acc)
    (cond
      ((eq tokens nil) (cons (reverse acc) nil))
      ((eq (tok-tag (car tokens)) 'RPAREN) (cons (reverse acc) (cdr tokens)))
      ((eq (tok-tag (car tokens)) 'DOT)
       (let ((r (parse-one (cdr tokens))))
         (let ((rest (cdr r)))
           (cond
             ;; consume the closing paren of the dotted list
             ((eq rest nil)
              (cons (chain-with-tail (reverse acc) (car r)) nil))
             ((eq (tok-tag (car rest)) 'RPAREN)
              (cons (chain-with-tail (reverse acc) (car r)) (cdr rest)))
             (true
              (cons (chain-with-tail (reverse acc) (car r)) rest))))))
      (true
        (let ((r (parse-one tokens)))
          (parse-list (cdr r) (cons (car r) acc)))))))

(define chain-with-tail
  (lambda (items tail)
    (cond
      ((eq items nil) tail)
      (true (cons (car items) (chain-with-tail (cdr items) tail))))))

(define arg1
  (lambda (args) (car args)))

(define arg2
  (lambda (args) (car (cdr args))))

(define arg3
  (lambda (args) (car (cdr (cdr args)))))

;; === environment ===
;; env = chain of frames; frame = chain of (name . value)
;; A closure body env may start with a FALLBACK marker frame:
;;   (FALLBACK global-env)
;; Lookup searches the body env first, then the recorded global env. This
;; models the language's pre-declared binding slots: forward references to
;; globals defined later resolve at call time instead of failing at capture.
(define make-env
  (lambda () (cons nil nil)))

(define make-standard-env
  (lambda ()
    (env-extend-top
      (env-extend-top
        (env-extend-top
          (env-extend-top
            (env-extend-top (make-env) 'nil nil)
            'true true)
          'false nil)
        'T true)
      'none none)))

(define marker-frame
  (lambda (fallback-env)
    (cons 'FALLBACK (cons fallback-env nil))))

(define marker-frame?
  (lambda (frame)
    (cond
      ((eq (type frame) 'chain) (eq (car frame) 'FALLBACK))
      (true nil))))

(define marker-env?
  (lambda (env)
    (cond
      ((eq env nil) nil)
      (true (marker-frame? (car env))))))

(define marker-fallback
  (lambda (frame) (car (cdr frame))))

;; Effective global environment of an env: the frames before the first
;; FALLBACK marker, plus the fallback recorded by that marker. For a top-level
;; env this is the whole chain; for a closure body env this is the *caller's*
;; global snapshot, which transitively reaches the latest top-level frame.
;; Nested closure calls therefore see globals defined after any of the
;; enclosing closures were created, without rescanning intermediate frames.
(define env-globals
  (lambda (env)
    (cond
      ((eq env nil) nil)
      ((marker-frame? (car env)) (marker-fallback (car env)))
      (true (cons (car env) (env-globals (cdr env)))))))

(define env-extend-top
  (lambda (env name value)
    (cond
      ;; Keep the FALLBACK marker at the head; insert new frames after it.
      ((marker-env? env)
       (cons (car env) (env-extend-top (cdr env) name value)))
      (true
       (cons (cons (cons name value) (car env)) (cdr env))))))

(define env-frame-find
  (lambda (name frame)
    (cond
      ((eq frame nil) nil)
      ((eq (car (car frame)) name) (cons true (cdr (car frame))))
      (true (env-frame-find name (cdr frame))))))

(define env-lookup
  (lambda (name env)
    (env-lookup-from name env nil)))

;; fallback-stack: nil or a chain of envs to try after `env` is exhausted.
(define env-lookup-from
  (lambda (name env fallback-stack)
    (cond
      ((eq env nil)
       (cond
         ((eq fallback-stack nil) name)
         (true (env-lookup-from name (car fallback-stack) (cdr fallback-stack)))))
      ((marker-frame? (car env))
       (env-lookup-from name (cdr env)
                        (cons (marker-fallback (car env)) fallback-stack)))
      (true
        (let ((hit (env-frame-find name (car env))))
          (cond
            ((eq hit nil) (env-lookup-from name (cdr env) fallback-stack))
            (true (cdr hit))))))))

;; === closures ===
;; closure = (CLOSURE params body env name-or-nil)
(define make-closure
  (lambda (params body env)
    (make-named-closure nil params body env)))

(define make-named-closure
  (lambda (name params body env)
    (cons 'CLOSURE (cons params (cons body (cons env (cons name nil)))))))

(define closure?
  (lambda (value)
    (cond
      ((eq (type value) 'chain)
       (cond
         ((eq (car value) 'CLOSURE) true)
         (true nil)))
      (true nil))))

(define closure-params
  (lambda (closure) (car (cdr closure))))

(define closure-body
  (lambda (closure) (car (cdr (cdr closure)))))

(define closure-env
  (lambda (closure) (car (cdr (cdr (cdr closure))))))

(define closure-name
  (lambda (closure) (car (cdr (cdr (cdr (cdr closure)))))))

(define bind-params
  (lambda (params vals env)
    (cond
      ((eq params nil) env)
      ;; macro rest parameters: (name args &body body) binds body to the
      ;; remaining argument forms as a chain.
      ((eq (car params) '&body)
       (env-extend-top env (arg1 (cdr params)) vals))
      ((eq (car params) '&rest)
       (env-extend-top env (arg1 (cdr params)) vals))
      (true
        (bind-params (cdr params) (cdr vals)
                     (env-extend-top env (car params) (car vals)))))))

(define bind-self
  (lambda (closure env)
    (let ((name (closure-name closure)))
      (cond
        ((eq name nil) env)
        (true (env-extend-top env name closure))))))

;; === contexts ===
;; A continuation is a closure (lambda (value env ctx) ...).
;; ctx = (HANDLERS . TARGETS) where
;;   HANDLERS : chain of (HANDLER clauses env k-out ctx-outer) records
;;   TARGETS  : chain of (RECORD . K) pairs; K receives the delimited body
;;              result when a resumed computation reaches the matching
;;              handler boundary.
(define make-ctx
  (lambda () (cons nil nil)))

(define ctx-handlers
  (lambda (ctx) (car ctx)))

(define ctx-targets
  (lambda (ctx) (cdr ctx)))

(define ctx-set-handlers
  (lambda (ctx handlers) (cons handlers (cdr ctx))))

(define ctx-push-target
  (lambda (ctx record cont env)
    (cons (car ctx) (cons (cons record (cons cont (cons env nil))) (cdr ctx)))))

(define ctx-pop-target
  (lambda (ctx) (cons (car ctx) (cdr (cdr ctx)))))

;; === effect values ===
;; effect value = (EFFECT name resumable?)
(define make-effect
  (lambda (name resumable) (cons 'EFFECT (cons name (cons resumable nil)))))

(define effect?
  (lambda (value)
    (cond
      ((eq (type value) 'chain) (eq (car value) 'EFFECT))
      (true nil))))

(define effect-name
  (lambda (effect) (car (cdr effect))))

(define effect-resumable?
  (lambda (effect) (car (cdr (cdr effect)))))

;; === handler records ===
;; (HANDLER clauses env k-out ctx-outer)
(define make-handler
  (lambda (clauses env k-out ctx-outer)
    (cons 'HANDLER (cons clauses (cons env (cons k-out (cons ctx-outer nil)))))))

(define handler-clauses
  (lambda (record) (car (cdr record))))

(define handler-env
  (lambda (record) (car (cdr (cdr record)))))

(define handler-k-out
  (lambda (record) (car (cdr (cdr (cdr record))))))

(define handler-ctx-outer
  (lambda (record) (car (cdr (cdr (cdr (cdr record)))))))

;; === first-class continuations captured at perform ===
;; (CONT kind k env ctx record resumable?)
;; kind = "delimited": resuming continues the perform site's body and returns
;;        the completion through the handler boundary;
;; kind = "identity":  resuming only returns the resumed value to the handler
;;        (host arithmetic effects such as divide-by-zero behave this way).
(define make-continuation
  (lambda (kind k env ctx record resumable)
    (cons 'CONT (cons kind (cons k (cons env (cons ctx (cons record (cons resumable nil)))))))))

(define continuation?
  (lambda (value)
    (cond
      ((eq (type value) 'chain) (eq (car value) 'CONT))
      (true nil))))

(define cont-kind
  (lambda (cont) (car (cdr cont))))

(define cont-k
  (lambda (cont) (car (cdr (cdr cont)))))

(define cont-env
  (lambda (cont) (car (cdr (cdr (cdr cont))))))

(define cont-ctx
  (lambda (cont) (car (cdr (cdr (cdr (cdr cont)))))))

(define cont-record
  (lambda (cont) (car (cdr (cdr (cdr (cdr (cdr cont))))))))

(define cont-resumable?
  (lambda (cont) (car (cdr (cdr (cdr (cdr (cdr (cdr cont)))))))))

;; === evaluator core (CPS) ===
(define eval-k
  (lambda (form env ctx k)
    (cond
      ((eq (type form) 'symbol) (k (env-lookup form env) env ctx))
      ((eq (type form) 'chain) (eval-call-k form env ctx k))
      (true (k form env ctx)))))

(define eval-call-k
  (lambda (form env ctx k)
    (let ((op (car form)) (args (cdr form)))
      (cond
        ((eq op 'quote) (k (arg1 args) env ctx))
        ((eq op 'if) (eval-if-k args env ctx k))
        ((eq op 'cond) (eval-cond-k args env ctx k))
        ((eq op 'define) (eval-define-k args env ctx k))
        ((eq op 'defun)
         (let ((r (define-closure (arg1 args) (cons 'lambda (cdr args)) env)))
           (k (car r) (cdr r) ctx)))
        ((eq op 'lambda)
         (k (make-closure (arg1 args) (cdr args) env) env ctx))
        ((eq op 'let) (eval-let-k (arg1 args) (cdr args) env ctx k))
        ((eq op 'and) (eval-and-k args env ctx k))
        ((eq op 'or) (eval-or-k args env ctx k))
        ((eq op 'from) (eval-from-k args env ctx k))
        ((eq op 'module) (eval-module-k args env ctx k))
        ((eq op 'exports) (k nil env ctx))
        ((eq op 'macro) (eval-macro-k args env ctx k))
        ((eq op 'defeffect) (eval-defeffect-k args env ctx k))
        ((eq op 'perform) (eval-perform-k args env ctx k))
        ((eq op 'handle) (eval-handle-k args env ctx k))
        ((eq op 'resume) (eval-resume-k args env ctx k))
        ((eq op 'quasiquote) (qq-k (arg1 args) 0 env ctx k))
        ((eq op 'unquote) (eval-k (arg1 args) env ctx k))
        ((eq op 'unquote-splicing) (eval-k (arg1 args) env ctx k))
        ((eq op 'bind) (eval-bind-k args env ctx k))
        ((eq op 'this) (k 'this-ss env ctx))
        ((eq op 'component) (k (cons 'COMPONENT nil) env ctx))
        ((eq op 'eval) (eval-datum-k args env ctx k))
        ((eq op 'reify) (eval-reify-k args env ctx k))
        ((eq op 'apply) (eval-apply-form-k args env ctx k))
        ((eq op 'pipeline) (eval-body-k args env ctx k))
        ((eq op 'parallel) (eval-gather-k args env ctx k))
        ((eq op 'all) (eval-gather-k args env ctx k))
        ((eq op 'race) (eval-race-k args env ctx k))
        (true (eval-apply-k op args env ctx k))))))

(define eval-if-k
  (lambda (args env ctx k)
    (eval-k (arg1 args) env ctx
      (lambda (condition env2 ctx2)
        (cond
          ((eq condition nil) (eval-k (arg3 args) env2 ctx2 k))
          (true (eval-k (arg2 args) env2 ctx2 k)))))))

(define eval-cond-k
  (lambda (clauses env ctx k)
    (cond
      ((eq clauses nil) (k nil env ctx))
      (true
        (let ((clause (car clauses)))
          (eval-k (arg1 clause) env ctx
            (lambda (condition env2 ctx2)
              (cond
                ((eq condition nil) (eval-cond-k (cdr clauses) env2 ctx2 k))
                (true (eval-k (arg2 clause) env2 ctx2 k))))))))))

(define eval-define-k
  (lambda (args env ctx k)
    (let ((name (quoted-name (arg1 args))) (rhs (arg2 args)))
      (cond
        ((lambda-form? rhs)
         (let ((r (define-closure name rhs env)))
           (k (car r) (cdr r) ctx)))
        (true
         (eval-k rhs env ctx
           (lambda (value env2 ctx2)
             (k value (env-extend-top env2 name value) ctx2))))))))

;; `(define 'name v)` / `(bind 'name v slot)` use a quoted symbol as the name.
(define quoted-name
  (lambda (form)
    (cond
      ((eq (type form) 'chain)
       (cond
         ((head-is? form 'quote) (arg1 (cdr form)))
         (true form)))
      (true form))))

;; `(lambda params body...)` as a datum (used to build self-recursive closures)
(define lambda-form?
  (lambda (form)
    (cond
      ((eq (type form) 'chain) (eq (car form) 'lambda))
      (true nil))))

(define define-closure
  (lambda (name rhs env)
    (let ((closure (make-named-closure
                     name (arg1 (cdr rhs)) (cdr (cdr rhs)) env)))
      (cons closure (env-extend-top env name closure)))))

(define eval-let-k
  (lambda (bindings body env ctx k)
    (eval-bindings-k bindings env ctx
      (lambda (frame env2 ctx2)
        (eval-body-k body (cons frame env2) ctx2
          (lambda (value body-env body-ctx)
            ;; `let` introduces a lexical symbol-space; its bindings (and any
            ;; local `define`) must not leak to the enclosing evaluation.
            (k value env body-ctx)))))))

(define eval-bindings-k
  (lambda (bindings env ctx k)
    (cond
      ((eq bindings nil) (k nil env ctx))
      (true
        (let ((binding (car bindings)))
          (eval-k (arg2 binding) env ctx
            (lambda (value env2 ctx2)
              (eval-bindings-k (cdr bindings) env2 ctx2
                (lambda (frame env3 ctx3)
                  (k (cons (cons (arg1 binding) value) frame) env3 ctx3))))))))))

(define eval-body-k
  (lambda (body env ctx k)
    (cond
      ((eq body nil) (k nil env ctx))
      ((eq (cdr body) nil) (eval-k (car body) env ctx k))
      (true
        (eval-k (car body) env ctx
          (lambda (value env2 ctx2)
            (eval-body-k (cdr body) env2 ctx2 k)))))))

(define eval-and-k
  (lambda (forms env ctx k)
    (cond
      ((eq forms nil) (k true env ctx))
      ((eq (cdr forms) nil) (eval-k (car forms) env ctx k))
      (true
        (eval-k (car forms) env ctx
          (lambda (value env2 ctx2)
            (cond
              ((eq value nil) (k nil env2 ctx2))
              (true (eval-and-k (cdr forms) env2 ctx2 k)))))))))

(define eval-or-k
  (lambda (forms env ctx k)
    (cond
      ((eq forms nil) (k nil env ctx))
      ((eq (cdr forms) nil) (eval-k (car forms) env ctx k))
      (true
        (eval-k (car forms) env ctx
          (lambda (value env2 ctx2)
            (cond
              ((eq value nil) (eval-or-k (cdr forms) env2 ctx2 k))
              (true (k value env2 ctx2)))))))))

(define eval-args-k
  (lambda (args env ctx k)
    (cond
      ((eq args nil) (k nil env ctx))
      (true
        (eval-k (car args) env ctx
          (lambda (value env2 ctx2)
            (eval-args-k (cdr args) env2 ctx2
              (lambda (vals env3 ctx3)
                (k (cons value vals) env3 ctx3)))))))))

(define eval-apply-k
  (lambda (op args env ctx k)
    (eval-k op env ctx
      (lambda (f env2 ctx2)
        (cond
          ((macro? f)
           (expand-macro-k f args ctx2
             (lambda (expansion env3 ctx3)
               (let ((hygienic (hygienize expansion (collect-arg-nodes args) (macro-env f))))
                 (eval-k (hw-form hygienic)
                         (env-push-frame (hw-bindings hygienic) env2)
                         ctx3 k)))))
          (true
           (eval-args-k args env2 ctx2
             (lambda (vals env3 ctx3)
               (apply-value-k f vals env3 ctx3 k)))))))))

(define eval-bind-k
  (lambda (args env ctx k)
    (eval-k (arg2 args) env ctx
      (lambda (value env2 ctx2)
        (k value (env-extend-top env2 (quoted-name (arg1 args)) value) ctx2)))))

(define eval-datum-k
  (lambda (args env ctx k)
    (eval-k (arg1 args) env ctx
      (lambda (datum env2 ctx2)
        (eval-k datum env2 ctx2 k)))))

(define eval-reify-k
  (lambda (args env ctx k)
    (eval-k (arg1 args) env ctx
      (lambda (value env2 ctx2)
        (k (reify-value value) env2 ctx2)))))

(define reify-value
  (lambda (value)
    (cond
      ;; nil / T / none reify to their syntax spellings (like the host does),
      ;; so `'nil` (a symbol datum) compares equal to the reified form.
      ((eq value nil) (string->symbol "nil"))
      ((eq value true) (string->symbol "T"))
      ((eq value none) (string->symbol "none"))
      ((eq (type value) 'chain)
       (cond
         ((closure? value) value)
         ((macro? value) value)
         ((effect? value) value)
         ((continuation? value) value)
         (true (reify-chain value))))
      (true value))))

(define reify-chain
  (lambda (items)
    (cond
      ((eq items nil) nil)
      (true (cons (reify-value (car items)) (reify-chain (cdr items)))))))

;; `(parallel ...)` / `(all ...)`: sequential evaluation is a legal
;; implementation ("parallel 只表示允许并行，不要求并行"); results are gathered
;; into a tuple, matching the host VM.
(define eval-gather-k
  (lambda (args env ctx k)
    (eval-args-k args env ctx
      (lambda (vals env2 ctx2)
        (k (apply tuple vals) env2 ctx2)))))

;; `(race ...)`: first-resume wins; sequential evaluation returns the value of
;; the first branch.
(define eval-race-k
  (lambda (args env ctx k)
    (cond
      ((eq args nil) (k nil env ctx))
      (true (eval-k (car args) env ctx k)))))

(define eval-apply-form-k
  (lambda (args env ctx k)
    (eval-k (arg1 args) env ctx
      (lambda (f env2 ctx2)
        (eval-k (arg2 args) env2 ctx2
          (lambda (vals env3 ctx3)
            (apply-value-k f vals env3 ctx3 k)))))))

(define apply-closure-k
  (lambda (closure vals call-env ctx k)
    (let ((env (bind-self closure (closure-env closure))))
      (eval-body-k (closure-body closure)
                   (cons (marker-frame (env-globals call-env))
                         (bind-params (closure-params closure) vals env))
                   ctx
                   ;; The callee's env (params, local defines) must not leak to
                   ;; the caller; ctx (handlers / resume targets) flows through
                   ;; so that handler boundaries and resumes stay balanced.
                   (lambda (value body-env body-ctx)
                     (k value call-env body-ctx))))))

(define apply-value-k
  (lambda (f vals env ctx k)
    (cond
      ((closure? f) (apply-closure-k f vals env ctx k))
      ;; Arithmetic that may raise language-level effects is dispatched through
      ;; the interpreted handler stack instead of letting the host signal leak.
      ((eq f '/) (eval-divide-k vals env ctx k))
      ((eq f 'mod) (eval-mod-k vals env ctx k))
      (true (k (apply-primitive f vals) env ctx)))))

;; `perform` synthesized by the interpreter itself (e.g. divide-by-zero raised
;; by arithmetic primitives). With no interpreted handler we fall back to the
;; host primitive so the host raises its usual unhandled-effect signal.
(define eval-synthetic-perform-k
  (lambda (name payload fallback env ctx k)
    (let ((record (find-handler name (ctx-handlers ctx))))
      (cond
        ((eq record nil) (k (fallback) env ctx))
        (true (dispatch-perform-kind 'identity name true payload env ctx k))))))

(define eval-divide-k
  (lambda (vals env ctx k)
    (cond
      ((div-zero? vals)
       (eval-synthetic-perform-k
         'divide-by-zero
         (cons '/ (cons (arg1 vals) (cdr vals)))
         (lambda () (apply-primitive '/ vals))
         env ctx k))
      (true (k (apply-primitive '/ vals) env ctx)))))

(define eval-mod-k
  (lambda (vals env ctx k)
    (cond
      ((eq (arg2 vals) 0)
       (eval-synthetic-perform-k
         'mod
         (cons 'mod (cons (arg1 vals) (cdr vals)))
         (lambda () (apply-primitive 'mod vals))
         env ctx k))
      (true (k (apply-primitive 'mod vals) env ctx)))))

(define div-zero?
  (lambda (vals)
    (cond
      ((eq vals nil) nil)
      ((eq (cdr vals) nil) (eq (arg1 vals) 0))
      (true (div-rest-zero? (cdr vals))))))

(define div-rest-zero?
  (lambda (vals)
    (cond
      ((eq vals nil) nil)
      ((eq (arg1 vals) 0) true)
      (true (div-rest-zero? (cdr vals))))))

(define apply-primitive
  (lambda (f vals)
    (cond
      ((eq (type f) 'function) (apply f vals))
      ((eq (type f) 'operator) (apply f vals))
      ((eq f '+) (apply-list-+ vals))
      ((eq f '*) (apply-list-* vals))
      ((eq f '-) (apply-list-minus vals))
      ((eq f '/) (apply-list-div vals))
      ((eq f 'mod) (prim-two mod vals))
      ((eq f 'len) (prim-one len vals))
      ((eq f 'truthy) (prim-one truthy vals))
      ((eq f 'is) (prim-two is vals))
      ((eq f '=) (prim-two = vals))
      ((eq f '==) (prim-two == vals))
      ((eq f '<) (prim-two < vals))
      ((eq f '>) (prim-two > vals))
      ((eq f '<=) (prim-two <= vals))
      ((eq f '>=) (prim-two >= vals))
      ((eq f 'eq) (prim-two eq vals))
      ((eq f 'eq?) (prim-two eq vals))
      ((eq f 'atom) (prim-atom vals))
      ((eq f 'car) (car (arg1 vals)))
      ((eq f 'cdr) (cdr (arg1 vals)))
      ((eq f 'cons) (cons (arg1 vals) (arg2 vals)))
      ((eq f 'list) (apply list vals))
      ((eq f 'get) (prim-two get vals))
      ((eq f 'dict) (apply dict vals))
      ((eq f 'slot) (cons 'SLOT nil))
      ((eq f 'null?) (qy-not (arg1 vals)))
      ((eq f 'not) (qy-not (arg1 vals)))
      ((eq f 'print) (print-value (arg1 vals)))
      ((eq f 'capture) (cons 'CAPTURED (cons (arg1 vals) nil)))
      ((eq f 'gensym) (prim-gensym vals))
      (true nil))))

;; === primitives ===
(define qy-not
  (lambda (value)
    (cond
      ((eq value nil) true)
      (true nil))))

(define prim-two
  (lambda (prim vals)
    ;; prim is a host operator value bound in the prelude, not a symbol.
    (prim (arg1 vals) (arg2 vals))))

(define prim-atom
  (lambda (vals)
    (atom (arg1 vals))))

(define prim-gensym
  (lambda (vals)
    (cond
      ((eq vals nil) (gensym))
      (true (gensym (arg1 vals))))))

(define prim-one
  (lambda (prim vals)
    (prim (arg1 vals))))

(define apply-list-+
  (lambda (vals)
    (cond
      ((eq vals nil) 0)
      ((eq (cdr vals) nil) (car vals))
      (true (+ (car vals) (apply-list-+ (cdr vals)))))))

(define apply-list-*
  (lambda (vals)
    (cond
      ((eq vals nil) 1)
      ((eq (cdr vals) nil) (car vals))
      (true (* (car vals) (apply-list-* (cdr vals)))))))

(define apply-list-minus
  (lambda (vals)
    (cond
      ((eq vals nil) 0)
      ((eq (cdr vals) nil) (- (car vals)))
      (true (apply-minus-fold (car vals) (cdr vals))))))

(define apply-minus-fold
  (lambda (acc rest)
    (cond
      ((eq rest nil) acc)
      (true (apply-minus-fold (- acc (car rest)) (cdr rest))))))

(define apply-list-div
  (lambda (vals)
    (cond
      ((eq vals nil) 1)
      ((eq (cdr vals) nil) (/ (car vals)))
      (true (apply-div-fold (car vals) (cdr vals))))))

(define apply-div-fold
  (lambda (acc rest)
    (cond
      ((eq rest nil) acc)
      (true (apply-div-fold (/ acc (car rest)) (cdr rest))))))

;; === algebraic effects ===
(define eval-defeffect-k
  (lambda (args env ctx k)
    (let ((name (arg1 args)))
      (let ((effect (make-effect name (defeffect-resumable-opt (cdr args)))))
        (k effect (env-extend-top env name effect) ctx)))))

(define defeffect-resumable-opt
  (lambda (options)
    (cond
      ((eq options nil) true)
      ((eq (arg1 options) ':resumable)
       (cond
         ((eq (arg2 options) 'false) nil)
         (true true)))
      (true true))))

(define eval-perform-k
  (lambda (args env ctx k)
    (eval-k (arg1 args) env ctx
      (lambda (effect-value env2 ctx2)
        (eval-k (arg2 args) env2 ctx2
          (lambda (payload env3 ctx3)
            (dispatch-perform
              (cond
                ((effect? effect-value) (effect-name effect-value))
                (true effect-value))
              (cond
                ((effect? effect-value) (effect-resumable? effect-value))
                (true true))
              payload env3 ctx3 k)))))))

(define find-handler
  (lambda (name handlers)
    (cond
      ((eq handlers nil) nil)
      ((find-clause name (handler-clauses (car handlers))) (car handlers))
      (true (find-handler name (cdr handlers))))))

(define find-clause
  (lambda (name clauses)
    (cond
      ((eq clauses nil) nil)
      ((eq (arg1 (car clauses)) name) (car clauses))
      (true (find-clause name (cdr clauses))))))

(define dispatch-perform
  (lambda (name resumable payload env ctx k)
    (dispatch-perform-kind 'delimited name resumable payload env ctx k)))

(define dispatch-perform-kind
  (lambda (kind name resumable payload env ctx k)
    (let ((record (find-handler name (ctx-handlers ctx))))
      (cond
        ((eq record nil)
         (raise-error (string-concat "unhandled effect: " (symbol->string name))))
        (true
         (let ((clause (find-clause name (handler-clauses record))))
           (let ((params (arg2 clause)))
             (let ((arg-name (arg1 params))
                   (k-name (arg2 params)))
               (let ((env2 (bind-params
                             (cons arg-name (cons k-name nil))
                             (cons payload
                                   (cons (make-continuation
                                           kind k env ctx record resumable) nil))
                             (handler-env record))))
                 (eval-body-k (cdr (cdr clause)) env2
                              (handler-exec-ctx record ctx)
                              (make-handler-cont (handler-k-out record)
                                                 (handler-ctx-outer record)
                                                 (handler-env record))))))))))))

(define handler-exec-ctx
  (lambda (record ctx)
    (cons (cons record (ctx-handlers (handler-ctx-outer record)))
          (ctx-targets ctx))))

(define make-handler-cont
  (lambda (k-out ctx-outer handle-env)
    (lambda (value env ctx) (k-out value handle-env ctx-outer))))

(define make-handle-body-cont
  (lambda (record k-out ctx-outer handle-env)
    (lambda (value env ctx)
      (let ((targets (ctx-targets ctx)))
        (cond
          ((eq targets nil) (k-out value handle-env ctx-outer))
          ((is (car (car targets)) record)
           ;; resume target = (record cont env): the handler continuation must
           ;; run in the handler's env, not the resumed body env.
           ((car (cdr (car targets)))
            value
            (car (cdr (cdr (car targets))))
            (ctx-pop-target ctx)))
          (true (k-out value handle-env ctx-outer)))))))

(define eval-handle-k
  (lambda (args env ctx k)
    (let ((first (arg1 args)) (second (arg2 args)))
      (cond
        ((on-form? first) (eval-handle-parts second first env ctx k))
        (true (eval-handle-parts first second env ctx k))))))

(define eval-handle-parts
  (lambda (body clauses env ctx k)
    (let ((record (make-handler (normalize-clauses clauses) env k ctx)))
      ;; `body` is a single expression; wrap it as a one-form body.
      (eval-body-k (cons body nil) env
                   (ctx-set-handlers ctx (cons record (ctx-handlers ctx)))
                   (make-handle-body-cont record k ctx env)))))

(define on-form?
  (lambda (form)
    (cond
      ((eq (type form) 'chain) (eq (car form) 'on))
      (true nil))))

(define normalize-clauses
  (lambda (clauses)
    (cond
      ((on-form? clauses) (cons (normalize-on-clause clauses) nil))
      ((eq (type clauses) 'chain)
       (cond
         ((eq clauses nil) nil)
         ((on-form? (car clauses))
          (cons (normalize-on-clause (car clauses)) (normalize-clauses (cdr clauses))))
         (true (cons (car clauses) (normalize-clauses (cdr clauses))))))
      (true nil))))

;; `(on effect (arg k) body...)`, `(on effect () body...)` and
;; `(on effect (arg) k body...)` all normalize to `(effect (arg k) body...)`.
(define normalize-on-clause
  (lambda (clause)
    (let ((effect (arg2 clause)) (params (arg3 clause)) (rest (cdr (cdr (cdr clause)))))
      (cond
        ((eq params nil) (normalize-on-params '_v effect rest))
        ((one-element-chain? params) (normalize-on-params (car params) effect rest))
        (true (cons effect (cons params rest)))))))

;; `(on effect (args...) [k] body...)`: the standalone symbol after the
;; parameter list names the continuation (default `k`), matching the host.
(define normalize-on-params
  (lambda (arg-name effect rest)
    (cond
      ((eq rest nil) (cons effect (cons (cons arg-name (cons 'k nil)) nil)))
      ((eq (type (car rest)) 'symbol)
       (cons effect (cons (cons arg-name (cons (car rest) nil)) (cdr rest))))
      (true (cons effect (cons (cons arg-name (cons 'k nil)) rest))))))

(define one-element-chain?
  (lambda (value)
    (cond
      ((eq (type value) 'chain) (eq (cdr value) nil))
      (true nil))))

(define eval-resume-k
  (lambda (args env ctx k)
    (eval-k (arg1 args) env ctx
      (lambda (cont-value env2 ctx2)
        (eval-k (arg2 args) env2 ctx2
          (lambda (value env3 ctx3)
            (resume-continuation cont-value value env3 ctx3 k)))))))

(define resume-continuation
  (lambda (cont-value value env ctx k)
    (cond
      ((continuation? cont-value)
       (cond
         ((eq (cont-resumable? cont-value) nil)
          (raise-error "resume: effect is not resumable"))
         ((eq (cont-kind cont-value) 'identity)
          (k value env ctx))
         (true
          ((cont-k cont-value)
           value
           (cont-env cont-value)
           (ctx-push-target (cont-ctx cont-value) (cont-record cont-value) k env)))))
      (true (raise-error "resume expects a continuation")))))

;; === modules ===
;; `(from module import name [as alias] ...)` — module may be an interpreted
;; module value or a host module name resolved through `lookup-export`.
(define eval-from-k
  (lambda (args env ctx k)
    (let ((module-ref (arg1 args)))
      (let ((module-value (env-lookup module-ref env)))
        (k nil (import-specs module-value module-ref (cdr (cdr args)) env) ctx)))))

(define import-specs
  (lambda (module-value module-ref items env)
    (cond
      ((eq items nil) env)
      (true
        (let ((item (arg1 items)))
          (cond
            ;; parenthesized spec: (name as alias) or (name alias)
            ((eq (type item) 'chain)
             (let ((name (arg1 item)))
               (let ((spec-rest (cdr item)))
                 (cond
                   ((as-marker? spec-rest)
                    (import-specs module-value module-ref (cdr items)
                                  (env-extend-top
                                    env (arg2 spec-rest)
                                    (resolve-import module-value module-ref name))))
                   ((eq spec-rest nil)
                    (import-specs module-value module-ref (cdr items)
                                  (env-extend-top
                                    env name
                                    (resolve-import module-value module-ref name))))
                   (true
                    (import-specs module-value module-ref (cdr items)
                                  (env-extend-top
                                    env (arg1 spec-rest)
                                    (resolve-import module-value module-ref name))))))))
            (true
             (let ((rest (cdr items)))
               (cond
                 ((as-marker? rest)
                  (import-specs module-value module-ref (cdr (cdr rest))
                                (env-extend-top
                                  env (arg2 rest)
                                  (resolve-import module-value module-ref item))))
                 (true
                  (import-specs module-value module-ref rest
                                (env-extend-top
                                  env item
                                  (resolve-import module-value module-ref item)))))))))))))

(define as-marker?
  (lambda (rest)
    (cond
      ((eq rest nil) nil)
      ((eq (arg1 rest) 'as) true)
      (true nil))))

(define resolve-import
  (lambda (module-value module-ref name)
    (cond
      ((module-value? module-value) (module-export-lookup module-value name))
      (true (lookup-export module-ref name)))))

;; `(module Name (exports a b ...) body...)` — evaluate body in a fresh env and
;; bind Name to a (MODULE name exports) value in the enclosing env.
(define eval-module-k
  (lambda (args env ctx k)
    (let ((name (arg1 args)))
      (let ((body (cdr args)))
        (eval-forms-env-k body (make-standard-env) ctx
          (lambda (values final-env ctx2)
            (let ((module (make-module name (collect-exports (exports-of body) final-env))))
              (k module (env-extend-top env name module) ctx2))))))))

(define eval-forms-env-k
  (lambda (forms env ctx k)
    (cond
      ((eq forms nil) (k nil env ctx))
      (true
        (eval-k (car forms) env ctx
          (lambda (value env2 ctx2)
            (eval-forms-env-k (cdr forms) env2 ctx2
              (lambda (values env3 ctx3)
                (k (cons value values) env3 ctx3)))))))))

(define exports-form?
  (lambda (form)
    (cond
      ((eq (type form) 'chain) (eq (car form) 'exports))
      (true nil))))

(define exports-of
  (lambda (forms)
    (cond
      ((eq forms nil) nil)
      ((exports-form? (car forms)) (cdr (car forms)))
      (true (exports-of (cdr forms))))))

(define collect-exports
  (lambda (names env)
    (cond
      ((eq names nil) nil)
      (true
        (cons (cons (arg1 names) (env-lookup (arg1 names) env))
              (collect-exports (cdr names) env))))))

(define make-module
  (lambda (name exports)
    (cons 'MODULE (cons name (cons exports nil)))))

(define module-value?
  (lambda (value)
    (cond
      ((eq (type value) 'chain) (eq (car value) 'MODULE))
      (true nil))))

(define assoc
  (lambda (name pairs)
    (cond
      ((eq pairs nil) nil)
      ((eq (car (car pairs)) name) (car pairs))
      (true (assoc name (cdr pairs))))))

(define module-export-lookup
  (lambda (module name)
    (let ((hit (assoc name (arg3 module))))
      (cond
        ((eq hit nil) nil)
        (true (cdr hit))))))

;; === macros ===
;; macro value = (MACRO params body env); expansion is non-hygienic.
(define make-macro
  (lambda (params body env)
    (cons 'MACRO (cons params (cons body (cons env nil))))))

(define macro?
  (lambda (value)
    (cond
      ((eq (type value) 'chain) (eq (car value) 'MACRO))
      (true nil))))

(define macro-params
  (lambda (macro) (car (cdr macro))))

(define macro-body
  (lambda (macro) (car (cdr (cdr macro)))))

(define macro-env
  (lambda (macro) (car (cdr (cdr (cdr macro))))))

(define eval-macro-k
  (lambda (args env ctx k)
    (let ((name (arg1 args)))
      (let ((macro (make-macro (arg2 args) (cdr (cdr args)) env)))
        (k macro (env-extend-top env name macro) ctx)))))

(define expand-macro-k
  (lambda (macro args ctx k)
    (eval-body-k (macro-body macro)
                 (bind-params (macro-params macro) args (macro-env macro))
                 ctx k)))

;; === macro hygiene ===
;; A naive expansion would let macro-introduced symbols capture call-site
;; bindings (and vice versa). `hygienize` walks the expansion:
;;   1. syntax that came from the call-site arguments stays untouched — nodes
;;      are tracked by identity (`is`), not by spelling;
;;   2. binders introduced by the macro body (let / lambda / defun) and their
;;      references are renamed to fresh symbols through the scope;
;;   3. free symbols introduced by the macro body are renamed and bound to the
;;      macro *definition-site* value (referential transparency), except
;;      special-form keywords;
;;   4. `(capture x)` is unwrapped so x keeps call-site resolution.
;; Walk results are triples: (form renames bindings), where renames is a chain
;; of (name . fresh) and bindings a chain of (fresh . definition-site value).

(define hw
  (lambda (form renames bindings)
    (cons form (cons renames (cons bindings nil)))))

(define hw-form (lambda (w) (car w)))
(define hw-renames (lambda (w) (car (cdr w))))
(define hw-bindings (lambda (w) (car (cdr (cdr w)))))

(define hygienize
  (lambda (form arg-nodes macro-env)
    (hygienize-expr form arg-nodes macro-env nil)))

(define hygienize-expr
  (lambda (form arg-nodes macro-env renames)
    (cond
      ((captured-value? form) (hw (captured-payload form) renames nil))
      ((eq (type form) 'symbol)
       (hygienize-symbol form arg-nodes macro-env renames))
      ((eq (type form) 'chain)
       (cond
         ((head-is? form 'quote) (hw form renames nil))
         ((head-is? form 'quasiquote) (hw form renames nil))
         ((head-is? form 'let) (hygienize-let form arg-nodes macro-env renames))
         ((head-is? form 'lambda) (hygienize-lambda form arg-nodes macro-env renames))
         ((head-is? form 'defun) (hygienize-defun form arg-nodes macro-env renames))
         (true (hygienize-chain form arg-nodes macro-env renames))))
      (true (hw form renames nil)))))

(define head-is?
  (lambda (form name)
    (eq (car form) name)))

(define hygienize-symbol
  (lambda (sym arg-nodes macro-env renames)
    (cond
      ((node-in? sym arg-nodes) (hw sym renames nil))
      ((special-form-name? sym) (hw sym renames nil))
      ((rename-lookup sym renames) (hw (rename-lookup sym renames) renames nil))
      (true
       (let ((fresh (gensym (symbol->string sym))))
         (hw fresh renames (cons (cons fresh (env-lookup sym macro-env)) nil)))))))

(define hygienize-chain
  (lambda (form arg-nodes macro-env renames)
    (let ((walked (hygienize-elements form arg-nodes macro-env renames)))
      (hw (hw-form walked) (hw-renames walked) (hw-bindings walked)))))

(define hygienize-elements
  (lambda (items arg-nodes macro-env renames)
    (cond
      ((eq items nil) (hw nil renames nil))
      (true
        (let ((first (hygienize-expr (car items) arg-nodes macro-env renames)))
          (let ((rest (hygienize-elements
                        (cdr items) arg-nodes macro-env (hw-renames first))))
            (hw (cons (hw-form first) (hw-form rest))
                (hw-renames rest)
                (append-chain (hw-bindings first) (hw-bindings rest)))))))))

(define hygienize-let
  (lambda (form arg-nodes macro-env renames)
    (let ((bindings-form (arg1 (cdr form)))
          (body (cdr (cdr form))))
      (let ((walked (hygienize-let-bindings bindings-form arg-nodes macro-env renames)))
        (let ((body-walked (hygienize-body
                             body arg-nodes macro-env (hw-renames walked))))
          (hw (cons 'let (cons (hw-form walked) (hw-form body-walked)))
              (hw-renames body-walked)
              (append-chain (hw-bindings walked) (hw-bindings body-walked))))))))

(define hygienize-let-bindings
  (lambda (bindings arg-nodes macro-env renames)
    (cond
      ((eq bindings nil) (hw nil renames nil))
      (true
        (let ((binding (car bindings)))
          (let ((value (hygienize-expr (arg2 binding) arg-nodes macro-env renames)))
            (let ((fresh (hygienize-binder (arg1 binding) arg-nodes)))
              (let ((rest (hygienize-let-bindings
                            (cdr bindings) arg-nodes macro-env
                            (cons (cons (arg1 binding) fresh) (hw-renames value)))))
                (hw (cons (cons fresh (cons (hw-form value) nil)) (hw-form rest))
                    (hw-renames rest)
                    (append-chain (hw-bindings value) (hw-bindings rest)))))))))))

(define hygienize-lambda
  (lambda (form arg-nodes macro-env renames)
    (let ((params-form (arg1 (cdr form)))
          (body (cdr (cdr form))))
      (let ((bound (hygienize-params params-form arg-nodes renames)))
        (let ((body-walked (hygienize-body
                             body arg-nodes macro-env (hw-renames bound))))
          (hw (cons 'lambda (cons (hw-form bound) (hw-form body-walked)))
              (hw-renames body-walked)
              (hw-bindings body-walked)))))))

(define hygienize-defun
  (lambda (form arg-nodes macro-env renames)
    (let ((name (arg1 (cdr form)))
          (params-form (arg2 (cdr form)))
          (body (cdr (cdr (cdr form)))))
      (let ((fresh (hygienize-binder name arg-nodes)))
        (let ((renames2 (cons (cons name fresh) renames)))
          (let ((bound (hygienize-params params-form arg-nodes renames2)))
            (let ((body-walked (hygienize-body
                                 body arg-nodes macro-env (hw-renames bound))))
              (hw (cons 'defun (cons fresh (cons (hw-form bound) (hw-form body-walked))))
                  (hw-renames body-walked)
                  (hw-bindings body-walked)))))))))

(define hygienize-params
  (lambda (params arg-nodes renames)
    (cond
      ((eq params nil) (hw nil renames nil))
      ((eq (car params) '&body)
       (let ((fresh (hygienize-binder (arg1 (cdr params)) arg-nodes)))
         (hw (cons '&body (cons fresh nil))
             (cons (cons (arg1 (cdr params)) fresh) renames)
             nil)))
      (true
        (let ((fresh (hygienize-binder (car params) arg-nodes)))
          (let ((rest (hygienize-params (cdr params) arg-nodes
                                        (cons (cons (car params) fresh) renames))))
            (hw (cons fresh (hw-form rest))
                (hw-renames rest)
                (hw-bindings rest))))))))

(define hygienize-binder
  (lambda (name arg-nodes)
    (cond
      ((node-in? name arg-nodes) name)
      ((special-form-name? name) name)
      (true (gensym (symbol->string name))))))

(define hygienize-body
  (lambda (body arg-nodes macro-env renames)
    (cond
      ((eq body nil) (hw nil renames nil))
      (true
        (let ((first (hygienize-expr (car body) arg-nodes macro-env renames)))
          (let ((rest (hygienize-body
                        (cdr body) arg-nodes macro-env (hw-renames first))))
            (hw (cons (hw-form first) (hw-form rest))
                (hw-renames rest)
                (append-chain (hw-bindings first) (hw-bindings rest)))))))))

(define rename-lookup
  (lambda (name renames)
    (cond
      ((eq renames nil) nil)
      ((eq (car (car renames)) name) (cdr (car renames)))
      (true (rename-lookup name (cdr renames))))))

(define collect-arg-nodes
  (lambda (args)
    (collect-nodes-chain args nil)))

(define collect-nodes-chain
  (lambda (items acc)
    (cond
      ((eq items nil) acc)
      (true (collect-nodes-chain (cdr items) (collect-nodes (car items) acc))))))

(define collect-nodes
  (lambda (form acc)
    (cond
      ((eq (type form) 'chain)
       (collect-nodes (cdr form) (collect-nodes (car form) (cons form acc))))
      (true (cons form acc)))))

(define node-in?
  (lambda (node nodes)
    (cond
      ((eq nodes nil) nil)
      ((is node (car nodes)) true)
      (true (node-in? node (cdr nodes))))))

(define env-push-frame
  (lambda (frame env) (cons frame env)))

(define component-value?
  (lambda (value)
    (cond
      ((eq (type value) 'chain) (eq (car value) 'COMPONENT))
      (true nil))))

(define captured-value?
  (lambda (value)
    (cond
      ((eq (type value) 'chain) (eq (car value) 'CAPTURED))
      (true nil))))

(define captured-payload
  (lambda (value) (arg2 value)))

(define special-form-name?
  (lambda (name)
    (cond
      ((eq name 'quote) true)
      ((eq name 'quasiquote) true)
      ((eq name 'unquote) true)
      ((eq name 'unquote-splicing) true)
      ((eq name 'if) true)
      ((eq name 'cond) true)
      ((eq name 'define) true)
      ((eq name 'defun) true)
      ((eq name 'lambda) true)
      ((eq name 'let) true)
      ((eq name 'and) true)
      ((eq name 'or) true)
      ((eq name 'from) true)
      ((eq name 'module) true)
      ((eq name 'exports) true)
      ((eq name 'macro) true)
      ((eq name 'defeffect) true)
      ((eq name 'perform) true)
      ((eq name 'handle) true)
      ((eq name 'resume) true)
      ((eq name 'apply) true)
      ((eq name 'pipeline) true)
      ((eq name 'parallel) true)
      ((eq name 'all) true)
      ((eq name 'race) true)
      ((eq name 'eval) true)
      ((eq name 'reify) true)
      ((eq name '&body) true)
      ((eq name '&rest) true)
      (true nil))))

;; === quasiquote / unquote / unquote-splicing ===
(define qq-k
  (lambda (form depth env ctx k)
    (cond
      ((eq (type form) 'chain)
       (let ((head (car form)))
         (cond
           ((eq head 'unquote)
            (cond
              ((= depth 0) (eval-k (arg1 (cdr form)) env ctx k))
              (true
               (qq-k (arg1 (cdr form)) (- depth 1) env ctx
                 (lambda (value env2 ctx2)
                   (k (cons 'unquote (cons value nil)) env2 ctx2))))))
           ((eq head 'quasiquote)
            (qq-k (arg1 (cdr form)) (+ depth 1) env ctx
              (lambda (value env2 ctx2)
                (k (cons 'quasiquote (cons value nil)) env2 ctx2))))
           ((eq head 'unquote-splicing)
            (qq-k (arg1 (cdr form)) (- depth 1) env ctx
              (lambda (value env2 ctx2)
                (k (cons 'unquote-splicing (cons value nil)) env2 ctx2))))
           (true (qq-list-k form depth env ctx k)))))
      (true (k form env ctx)))))

(define qq-list-k
  (lambda (items depth env ctx k)
    (cond
      ((eq items nil) (k nil env ctx))
      (true
        (let ((item (car items)))
          (cond
            ((qq-splice? item depth)
             (eval-k (arg1 (cdr item)) env ctx
               (lambda (value env2 ctx2)
                 (qq-list-k (cdr items) depth env2 ctx2
                   (lambda (rest env3 ctx3)
                     (k (append-chain value rest) env3 ctx3))))))
            (true
             (qq-k item depth env ctx
               (lambda (value env2 ctx2)
                 (qq-list-k (cdr items) depth env2 ctx2
                   (lambda (rest env3 ctx3)
                     (k (cons value rest) env3 ctx3))))))))))))

(define qq-splice?
  (lambda (item depth)
    (cond
      ((= depth 0)
       (cond
         ((eq (type item) 'chain) (eq (car item) 'unquote-splicing))
         (true nil)))
      (true nil))))

(define append-chain
  (lambda (left right)
    (cond
      ((eq left nil) right)
      (true (cons (car left) (append-chain (cdr left) right))))))

;; === host output ===
;; `display` 只做 Qy display 格式化，不解析 literal spelling；宿主 `print` 则
;; 会把 `'true` 这类符号解析成 runtime value，因此解释器内部不能用它直接打印。
(define print-value
  (lambda (value) (print (display value))))

;; === driver ===
(define interp-source
  (lambda (src)
    (run-forms (parse-all (tokenize-string src)) (make-standard-env))))

;; Should this top-level form's *result value* be hidden from output?
;; Mirrors `qy run`: import/effect/form definitions produce no user output,
;; and function definitions evaluate to closure artifacts (also hidden).
(define skip-form-result?
  (lambda (form value)
    ;; Host `qy run` hides function artifacts; interpreted closures correspond
    ;; to host BytecodeFunctionValue, so any closure result is hidden. This also
    ;; covers macro calls whose expansion is a `define`/`defun`.
    (cond
      ((closure? value) true)
      ((component-value? value) true)
      ((eq (type form) 'chain)
       (let ((head (car form)))
         (cond
           ((eq head 'from) true)
           ((eq head 'module) true)
           ((eq head 'defeffect) true)
           ((eq head 'macro) true)
           (true nil))))
      (true nil))))

(define run-forms
  (lambda (forms env)
    (collect-k forms env (make-ctx)
      (lambda (results env2 ctx2)
        (emit-all-results results)))))

;; Evaluate every form, threading env, and collect (form . value) pairs.
;; Printing happens afterwards so that side-effect output precedes the results,
;; matching `qy run` (which echoes collected results after evaluation).
(define collect-k
  (lambda (forms env ctx k)
    (cond
      ((eq forms nil) (k nil env ctx))
      (true
        (let ((form (car forms)))
          (eval-k form env ctx
            (lambda (value env2 ctx2)
              (collect-k (cdr forms) env2 ctx2
                (lambda (results env3 ctx3)
                  (k (cons (cons form value) results) env3 ctx3))))))))))

(define emit-all-results
  (lambda (results)
    (cond
      ((eq results nil) nil)
      (true
        (let ((ignored (emit-result (car results))))
          (emit-all-results (cdr results)))))))

(define emit-result
  (lambda (result)
    (cond
      ((skip-form-result? (car result) (cdr result)) nil)
      (true (print-value (cdr result))))))

(define run-source-file
  (lambda (path)
    (interp-source (read-file path))))

(define run-source-files
  (lambda (paths)
    (cond
      ((eq paths nil) nil)
      (true
        (let ((ignored (run-source-file (car paths))))
          (run-source-files (cdr paths)))))))

(define run-self-test-loop
  (lambda (sources)
    (cond
      ((eq sources nil) nil)
      (true
        (let ((ignored (interp-source (car sources))))
          (run-self-test-loop (cdr sources)))))))

(define run-self-test
  (lambda ()
    (run-self-test-loop
      (cons "(+ 1 2)"
        (cons "(cond ((= 1 0) 'no) ((= 1 1) 'yes))"
          (cons "(define f (lambda (x) (+ x 1))) (f 41)"
            (cons "(car '(a b c)) (cdr '(a b c)) (cons 'head '(tail))"
              (cons "(define square (lambda (x) (* x x))) (square 7) ((lambda (a b) (+ a b)) 10 32)"
                (cons "(defeffect ask) (handle (perform ask 7) ((ask (x k) (resume k (+ x 35)))))"
                (cons "(defeffect inner) (defeffect outer) (handle (perform inner (handle (perform outer 10) ((outer (x k) (resume k (* x 5)))))) ((inner (v k) (resume k (+ v 1)))))"
                  nil))))))))))

(define interp-entry
  (lambda ()
    (let ((args (cli-args)))
      (cond
        ((eq args nil) (run-self-test))
        (true (run-source-files args))))))

;; `interp-main` returns a function value so the host `qy run` flattens it as a
;; definition artifact and does not echo it: this interpreter prints all
;; visible results itself, in the same order as `qy run` would.
(define secret-result
  (lambda () nil))

(define interp-main
  (lambda ()
    (let ((ignored (interp-entry)))
      secret-result)))

(interp-main)
