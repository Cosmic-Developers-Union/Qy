(macro with-temp (expr)
  (cons 'let
    (cons
      (cons (cons 'tmp (cons 1 '())) '())
      (cons expr '()))))
(macro add-one (value)
  (cons '+ (cons value (cons 1 '()))))
(macro call-site-plus (value)
  (cons (capture '+) (cons value (cons 1 '()))))
(macro bind-once (value)
  (let ((name (gensym)))
    `(let ((,name ,value))
       ,name)))
(let ((tmp 99)) (with-temp tmp))
(let ((+ (lambda (left right) 0))) (add-one 41))
(let ((+ (lambda (left right) 0))) (call-site-plus 41))
(bind-once (+ 20 22))
