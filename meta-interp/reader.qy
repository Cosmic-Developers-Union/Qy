;; meta-interp/reader.qy -- tokenizer + parser for Qy source.
;; Tokenizer turns a string into a chain of tokens.
;; Parser turns a token chain into a chain of Qy forms.

;; ----- helpers -----

(define reverse-acc
  (lambda (lst acc)
    (cond
      ((eq lst nil) acc)
      (true (reverse-acc (cdr lst) (cons (car lst) acc))))))

(define reverse (lambda (lst) (reverse-acc lst nil)))

;; ----- tokenizer -----

;; Strip ';' comments. Replace ';' ... '\n' with ' '.
(define strip-comments
  (lambda (src)
    (let ((idx (str-find src ";")))
      (cond
        ((eq idx nil) src)
        (true
          (let ((after-semi (str-slice src (+ idx 1) nil)))
            (let ((eol (str-find after-semi "\n")))
              (cond
                ((eq eol nil) (str-slice src 0 idx))
                (true
                  (str-concat
                    (str-slice src 0 idx)
                    (str-concat
                      " "
                      (strip-comments (str-slice src (+ idx eol 2) nil))))))))))))

(define skip-spaces
  (lambda (src)
    (cond
      ((str-empty? src) src)
      ((str-whitespace? (str-slice src 0 1))
       (skip-spaces (str-slice src 1 nil)))
      (true src))))

;; Read a string literal starting at index 0. Returns (value . remaining-after-quote).
(define read-string-literal
  (lambda (src)
    (read-string-body src "")))

(define read-string-body
  (lambda (src acc)
    (cond
      ((str-empty? src) (cons acc src))
      ((str=? (str-slice src 0 1) "\\")
       (cond
         ((str-empty? (str-slice src 1 nil)) (cons acc src))
         (true
           (let ((escaped (str-slice src 1 2)))
             (cond
               ((str=? escaped "n") (read-string-body (str-slice src 2 nil) (str-concat acc "\n")))
               ((str=? escaped "t") (read-string-body (str-slice src 2 nil) (str-concat acc "\t")))
               ((str=? escaped "r") (read-string-body (str-slice src 2 nil) (str-concat acc "\r")))
               ((str=? escaped "\\") (read-string-body (str-slice src 2 nil) (str-concat acc "\\")))
               ((str=? escaped "\"") (read-string-body (str-slice src 2 nil) (str-concat acc "\"")))
               (true (read-string-body (str-slice src 1 nil) (str-concat acc escaped))))))))
      ((str=? (str-slice src 0 1) "\"") (cons acc src))
      (true (read-string-body (str-slice src 1 nil)
                             (str-concat acc (str-slice src 0 1)))))))

;; Read a non-string atom starting at index 0. Returns (token . remaining).
(define read-atom
  (lambda (src)
    (let ((end (find-atom-end src 0)))
      (cond
        ((= end 0)
         (cons (cons 'SYM "|parse-error|") (str-slice src 1 nil)))
        (true
          (let ((text (str-slice src 0 end))
                (rest (str-slice src end nil)))
            (cond
              ((num-string? text)
               (cons (cons 'NUM (str->num text)) rest))
              (true (cons (cons 'SYM text) rest)))))))))

(define find-atom-end
  (lambda (src i)
    (cond
      ((>= i (str-length src)) i)
      ((str-delimiter? (str-slice src i (+ i 1))) i)
      (true (find-atom-end src (+ i 1))))))

;; Tokenize the source string. Returns chain of tokens.
;; Each token is one of:
;;   '(LPAREN)  '(RPAREN)  '(QUOTE)
;;   (cons 'SYM name)
;;   (cons 'NUM value)
;;   (cons 'STR value)
(define tokenize-after
  (lambda (src acc)
    (let ((src (skip-spaces src)))
      (cond
        ((str-empty? src) (reverse acc))
        ((str=? (str-slice src 0 1) "(")
         (tokenize-after (str-slice src 1 nil) (cons '(LPAREN) acc)))
        ((str=? (str-slice src 0 1) ")")
         (tokenize-after (str-slice src 1 nil) (cons '(RPAREN) acc)))
        ((str=? (str-slice src 0 1) "'")
         (tokenize-after (str-slice src 1 nil) (cons '(QUOTE) acc)))
        ((str=? (str-slice src 0 1) "\"")
         (let ((r (read-string-literal (str-slice src 1 nil))))
           (tokenize-after (str-slice (cdr r) 1 nil)
                           (cons (cons 'STR (car r)) acc))))
        (true
          (let ((r (read-atom src)))
            (tokenize-after (cdr r) (cons (car r) acc))))))))

(define tokenize
  (lambda (src) (tokenize-after (strip-comments src) nil)))

;; ----- parser -----

(define parse-all
  (lambda (tokens) (parse-all-acc tokens nil)))

(define parse-all-acc
  (lambda (tokens acc)
    (cond
      ((eq tokens nil) (reverse acc))
      (true
        (let ((r (parse-one tokens)))
          (parse-all-acc (car (cdr r)) (cons (car r) acc)))))))

(define parse-one
  (lambda (tokens)
    (let ((tok (car tokens)))
      (cond
        ((eq tok '(QUOTE))
         (let ((inner (parse-one (cdr tokens))))
           (cons (cons 'quote (cons (car inner) nil))
                 (car (cdr inner)))))
        ((eq tok '(LPAREN))
         (parse-list (cdr tokens) nil))
        ((eq tok '(RPAREN))
         (cons '|parse-error:unexpected-)| tokens))
        (true
          (cond
            ((eq (car tok) 'SYM)
             (cons (intern-sym (cdr tok)) (cdr tokens)))
            ((eq (car tok) 'NUM)
             (cons (cdr tok) (cdr tokens)))
            ((eq (car tok) 'STR)
             (cons (cdr tok) (cdr tokens)))
            (true (cons '|parse-error| tokens))))))))

(define parse-list
  (lambda (tokens acc)
    (let ((tok (car tokens)))
      (cond
        ((eq tok '(RPAREN))
         (cons (reverse acc) (cdr tokens)))
        ((eq tok '(LPAREN))
         (let ((sub (parse-list (cdr tokens) nil)))
           (parse-list (car (cdr sub)) (cons (car sub) acc))))
        ((eq tok '(QUOTE))
         (let ((inner (parse-one (cdr tokens))))
           (parse-list (car (cdr inner))
                       (cons (cons 'quote (cons (car inner) nil)) acc))))
        (true
          (let ((item (parse-one tokens)))
            (parse-list (car (cdr item)) (cons (car item) acc))))))))

(define parse
  (lambda (src) (parse-all (tokenize src))))
